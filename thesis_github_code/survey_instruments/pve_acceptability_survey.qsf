border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q26","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Familiarity with P+R Before this survey, were you familiar with P+R as a commute option to ASML?","Choices":{"1":{"Display":"Yes, I know how it works"},"2":{"Display":"Yes, I have heard of it, but I do not know exactly how it works"},"3":{"Display":"No, I was not familiar with it"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID26"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"What is P+R? P+R stands for Park & Ride. It means that you park your car at a parking location ou...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">What is P+R?<\/div>\n\n  <p class=\"ranking-question-text\">\n    P+R stands for <strong>Park & Ride<\/strong>.\n    It means that you park your car at a parking location outside the ASML campus and then continue the last part of your trip using another transport option.\n  <\/p>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">How P+R works in this survey<\/div>\n\n    <p>\n      In this survey, P+R refers to using <strong>P+R Koningshof<\/strong>.\n      Employees can park there and then travel from P+R Koningshof to the ASML campus by <strong>shuttle bus<\/strong> or <strong>e-bike<\/strong>.\n    <\/p>\n\n    <div class=\"ranking-example-box\">\n      In short: you drive to P+R Koningshof, park there, and then take a shuttle bus or e-bike to campus.\n    <\/div>\n  <\/div>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">Why ASML has a P+R<\/div>\n\n    <p>\n      The goal of P+R is to reduce the number of cars travelling directly to the ASML campus, while still offering employees a flexible way to complete their commute.\n    <\/p>\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n.ranking-list {\n  margin: 12px 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-list li {\n  margin: 6px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q27","QuestionID":"QID27","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is P+R? P+R stands for Park & Ride. It means that you park your car at a parking location ou...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID26\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">\n\n  Car availability\n\n  \n    Do you have a car available for your commute to ASML, regardless of your actual use of car?\n  \n\n\n\n\n\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  f...<\/span> <span class=\"LeftOpDesc\">Yes, I have heard of it, but I do not know exactly how it works<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID26\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID26","QuestionIDFromLocator":"QID26","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID26\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">\n\n  Car availability\n\n  \n    Do you have a car available for your commute to ASML, regardless of your actual use of car?\n  \n\n\n\n\n\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  f...<\/span> <span class=\"LeftOpDesc\">No, I was not familiar with it<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID26\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID26","QuestionIDFromLocator":"QID26","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true}}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"Familiarity with vanpool Before this survey, were you familiar with vanpool as a commute option t...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Familiarity with vanpool<\/div>\n\n  <p class=\"ranking-question-text\">\n    Before this survey, were you familiar with vanpool as a commute option to ASML?\n  <\/p>\n\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q28","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Familiarity with vanpool Before this survey, were you familiar with vanpool as a commute option t...","Choices":{"1":{"Display":"Yes, I know how it works"},"2":{"Display":"Yes, I have heard of it, but I do not know exactly how it works"},"3":{"Display":"No, I was not familiar with it"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID28"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"What is vanpool? Vanpooling is a shared commuting option where a group of employees travels toget...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">What is vanpool?<\/div>\n\n  <p class=\"ranking-question-text\">\n    Vanpooling is a shared commuting option where a group of employees travels together to campus in a professionally driven shuttle.\n    The vanpool is organized specifically for ASML employees and is designed to reduce individual car use and commuting costs.\n  <\/p>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">How vanpool works<\/div>\n\n    <p>\n      Vanpooling is available in <strong>Uden<\/strong>, <strong>Veghel<\/strong>, <strong>Rosmalen<\/strong>, and <strong>'s-Hertogenbosch<\/strong>.\n      The shuttles depart from a location that is easily accessible for both the shuttle and employees, such as a carpool spot or a free parking area with bicycle parking facilities.\n    <\/p>\n\n    <div class=\"ranking-example-box\">\n      In short: you travel together with other ASML employees in a professionally driven shuttle from a fixed pick-up location to campus.\n    <\/div>\n  <\/div>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">Pick-up locations<\/div>\n\n    <p>\n      The pick-up locations in each city are:\n    <\/p>\n\n    <ul class=\"ranking-list\">\n      <li><strong>Rosmalen:<\/strong> Carpoolplaats Rosmalen<\/li>\n      <li><strong>'s-Hertogenbosch East:<\/strong> Parkeerplaats Station 's-Hertogenbosch Oost<\/li>\n      <li><strong>'s-Hertogenbosch Centre:<\/strong> Kiss and ride Station Den Bosch<\/li>\n      <li><strong>Veghel:<\/strong> Carpool Veghel Noord<\/li>\n      <li><strong>Uden:<\/strong> Foodcourt Uden-Noord<\/li>\n    <\/ul>\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n.ranking-list {\n  margin: 12px 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-list li {\n  margin: 6px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q29","QuestionID":"QID29","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is vanpool? Vanpooling is a shared commuting option where a group of employees travels toget...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"InPageDisplayLogic":{"0":{"0":{"QuestionID":"QID28","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID28\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID28","LeftOperand":"q:\/\/QID28\/SelectableChoice\/2","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">\n\n  Familiarity with vanpool\n\n  \n    Before this survey, were you familiar with vanpool as a commute option to ASML?\n  \n\n\n\n\n\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-...<\/span> <span class=\"LeftOpDesc\">Yes, I have heard of it, but I do not know exactly how it works<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"1":{"QuestionID":"QID28","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID28\/SelectableChoice\/3","Operator":"Selected","QuestionIDFromLocator":"QID28","LeftOperand":"q:\/\/QID28\/SelectableChoice\/3","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">\n\n  Familiarity with vanpool\n\n  \n    Before this survey, were you familiar with vanpool as a commute option to ASML?\n  \n\n\n\n\n\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-...<\/span> <span class=\"LeftOpDesc\">No, I was not familiar with it<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","Conjuction":"Or"},"Type":"If"},"Type":"BooleanExpression","inPage":true}}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Mobility policy experiment This part of the survey is called a Participatory Value Evaluation (PV...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"pve-info-container\">\n<div class=\"pve-info-title\">Mobility policy experiment<\/div>\n\n<div class=\"pve-info-intro\">This part of the survey is called a <strong>Participatory Value Evaluation (PVE)<\/strong>. In this task, you will take the perspective of ASML and consider which mobility policies should be implemented for employees.<\/div>\n\n<div class=\"pve-info-highlight\">The aim is to improve the current commuting situation. This means encouraging alternatives to parking on campus and making commuting more balanced, while also keeping policies reasonable and acceptable for employees.<\/div>\n\n<div class=\"pve-info-section-title\">How employees currently commute<\/div>\n\n<div class=\"pve-info-layout\">\n<div class=\"pve-info-box\">\n<div class=\"pve-info-card-header\">\n<h4>Current modal split<\/h4>\n<\/div>\n\n<div class=\"pve-info-card-body\">\n<p>This gives an approximate picture of how employees currently commute to ASML:<\/p>\n\n<div class=\"modal-split-layout\">\n<div id=\"currentModalPie\">&nbsp;<\/div>\n\n<div class=\"modal-legend\">\n<div class=\"legend-row\">Car: <strong>50%<\/strong><\/div>\n\n<div class=\"legend-row\">Bicycle: <strong>35%<\/strong><\/div>\n\n<div class=\"legend-row\">Public transport: <strong>15%<\/strong><\/div>\n<\/div>\n<\/div>\n\n<p class=\"modal-goal-text\">\nThe current commuting pattern is not sustainable given the expected growth and the already constrained mobility environment. \n  Therefore, the aim is to move toward a more balanced distribution between car, bicycle, and public transport.\n\n<\/p>\n\t\n<\/div>\n<\/div>\n\n<div class=\"pve-info-box\">\n<div class=\"pve-info-card-header\">\n<h4>How to approach this task<\/h4>\n<\/div>\n\n<div class=\"pve-info-card-body\">\n<ul class=\"pve-bullet-list\">\n\t<li>You will be presented with a set of possible mobility policies.<\/li>\n\t<li>Each policy affects the modal split differently and therefore varies in <strong>effectiveness<\/strong>.<\/li>\n\t<li>These effects are <strong>based on results from a previous survey<\/strong>.<\/li>\n\t<li><strong>Try to place yourself in the role of an ASML policymaker<\/strong> \u2014 consider what would be best for the organisation as a whole, given that the current commuting situation is not sustainable and needs improvement.<\/li>\n<\/ul>\n\n<p class=\"pve-bold-note\">In general, stronger policies that encourage alternatives to driving and parking on campus can be beneficial, but your policy package should remain fair and realistic.<\/p>\n<\/div>\n<\/div>\n<\/div>\n\n<div class=\"pve-transition-text\">Please take a moment to read each of the candidate policies carefully, as you will use them in the next questions<\/div>\n<\/div>\n\n<div class=\"pve-info-section-title\">Candidate mobility policies<\/div>\n\n<div class=\"pve-policy-grid\">\n<div class=\"pve-info-box\">\n<div class=\"pve-info-card-header\">\n<h4>Parking rights policy<\/h4>\n<\/div>\n\n<div class=\"pve-info-card-body\">\n<p class=\"pve-policy-description\">Employees can voluntarily give up their parking rights at the ASML campus for four years while still being allowed to park at the P+R, in exchange for one of several alternative benefits:<\/p>\n\n<div class=\"pve-policy-list-box\">\n<ul>\n\t<li>Free e-bike<\/li>\n\t<li>Unlimited public transport<\/li>\n\t<li>Free EV charging point installed at home<\/li>\n\t<li>&euro;2,000 cash reward<\/li>\n<\/ul>\n<\/div>\n<\/div>\n<\/div>\n\n<div class=\"pve-info-box\">\n<div class=\"pve-info-card-header\">\n<h4>Parking payment policy<\/h4>\n<\/div>\n\n<div class=\"pve-info-card-body\">\n<p class=\"pve-policy-description\">Employees pay a fee when they use a parking spot at ASML. In the experiment, this fee can be &euro;0, &euro;1.50, or &euro;3 per parking day.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"pve-info-box\">\n<div class=\"pve-info-card-header\">\n<h4>Parking reservation system<\/h4>\n<\/div>\n\n<div class=\"pve-info-card-body\">\n<p class=\"pve-policy-description\">Parking priority is given to employees who live further away from ASML. In this policy, employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters. These employees can reserve a parking spot a few days earlier.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"pve-info-box\">\n<div class=\"pve-info-card-header\">\n<h4>P+R reward<\/h4>\n<\/div>\n\n<div class=\"pve-info-card-body\">\n<p class=\"pve-policy-description\">Employees receive a financial reward when they use Park &amp; Ride. In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike. In the experiment, the reward can be &euro;0, &euro;1.50, or &euro;3 per parking day.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"pve-info-box\">\n<div class=\"pve-info-card-header\">\n<h4>Vanpool emergency taxi<\/h4>\n<\/div>\n\n<div class=\"pve-info-card-body\">\n<p class=\"pve-policy-description\">Employees who use vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"pve-info-box\">\n<div class=\"pve-info-card-header\">\n<h4>Vanpool departures<\/h4>\n<\/div>\n\n<div class=\"pve-info-card-body\">\n<p class=\"pve-policy-description\">This policy changes how often vanpools depart. In the experiment, vanpools can depart 1, 2, or 4 times per hour.<\/p>\n<\/div>\n<\/div>\n<\/div>\n\n<div class=\"pve-info-final-box\">When you have read all policies, click &lsquo;Next&rsquo; to begin selecting which you would implement.<\/div>\n<style type=\"text\/css\">#pve-info-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.pve-info-title {\n  font-size: 36px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 20px;\n}\n\n.pve-info-intro {\n  font-size: 22px;\n  line-height: 1.4;\n  color: #4b5563;\n  margin-bottom: 20px;\n}\n\t\n.modal-goal-text {\n  margin-top: 18px;\n  font-weight: 700;\n  color: #0072ce; \/* blue *\/\n}\n\n.pve-info-highlight {\n  font-size: 17px;\n  line-height: 1.5;\n  color: #374151;\n  background: #f3f8ff;\n  border-left: 5px solid #0072ce;\n  border-radius: 10px;\n  padding: 16px 18px;\n  margin-bottom: 28px;\n}\n\n.pve-info-section-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: #003b8f;\n  margin: 28px 0 16px 0;\n}\n\n.pve-info-layout {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 22px;\n  margin-bottom: 24px;\n}\n\t\n.pve-transition-text {\n  font-size: 18px;\n  line-height: 1.5;\n  color: #166534;\n  margin: 26px 0 18px 0;\n  padding: 16px 18px;\n  background: #f0fdf4;\n  border: 2px solid #22c55e;\n  border-radius: 12px;\n  font-weight: 600;\n}\n\n.pve-policy-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 22px;\n}\n\n.pve-info-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.10);\n  overflow: hidden;\n}\n\n.pve-info-card-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 16px 18px;\n}\n\n.pve-info-card-header h4 {\n  margin: 0;\n  font-size: 22px;\n  font-weight: 800;\n  color: white;\n}\n\n.pve-info-card-body {\n  padding: 18px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.modal-split-layout {\n  display: flex;\n  align-items: center;\n  gap: 24px;\n  margin-top: 18px;\n}\n\n#currentModalPie {\n  width: 145px;\n  height: 145px;\n  border-radius: 50%;\n  background: conic-gradient(\n    #003b8f 0% 50%,\n    #76b82a 50% 85%,\n    #00a3e0 85% 100%\n  );\n  border: 2px solid white;\n  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.10);\n  flex-shrink: 0;\n}\n\n.modal-legend {\n  font-size: 15px;\n}\n\n.legend-row {\n  font-size: 15px;\n  text-align: left;\n  margin: 10px 0;\n}\n\n.dot {\n  display: inline-block;\n  width: 11px;\n  height: 11px;\n  border-radius: 50%;\n  margin-right: 7px;\n}\n\n.dot.car { background: #003b8f; }\n.dot.bike { background: #76b82a; }\n.dot.pt { background: #00a3e0; }\n\n.target-info-box {\n  margin: 16px 0;\n  padding: 13px;\n  border-radius: 10px;\n  background: #fff7ed;\n  border: 1.5px solid #fb923c;\n  font-size: 15px;\n  line-height: 1.4;\n  color: #374151;\n}\n\n.pve-policy-description {\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n  min-height: 95px;\n  margin: 0;\n}\n\n.pve-info-final-box {\n  margin-top: 28px;\n  padding: 18px;\n  border-radius: 14px;\n  background: #f0fdf4;\n  border: 2px solid #22c55e;\n  color: #166534;\n  font-size: 18px;\n  line-height: 1.45;\n  font-weight: 600;\n}\n\n@media only screen and (max-width: 800px) {\n  .pve-info-layout,\n  .pve-policy-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .modal-split-layout {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}\n<\/style>\n<style type=\"text\/css\">.pve-policy-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.pve-policy-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.pve-policy-list-box li {\n  margin: 5px 0;\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q3","QuestionID":"QID3","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Mobility policy experiment This part of the survey is called a Participatory Value Evaluation (PV...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"Is vanpool feasible for you? Vanpooling is currently available from the following pick-up locatio...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Is vanpool feasible for you?<\/div>\n\n  <p class=\"ranking-question-text\">\n    Vanpooling is currently available from the following pick-up locations:\n  <\/p>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">Current vanpool pick-up locations<\/div>\n\n    <ul class=\"ranking-list\">\n      <li><strong>Rosmalen:<\/strong> Carpoolplaats Rosmalen<\/li>\n      <li><strong>'s-Hertogenbosch East:<\/strong> Parkeerplaats Station 's-Hertogenbosch Oost<\/li>\n      <li><strong>'s-Hertogenbosch Centre:<\/strong> Kiss and ride Station Den Bosch<\/li>\n      <li><strong>Veghel:<\/strong> Carpool Veghel Noord<\/li>\n      <li><strong>Uden:<\/strong> Foodcourt Uden-Noord<\/li>\n    <\/ul>\n\n    <div class=\"ranking-example-box\">\n      Based on these current locations, please indicate whether vanpooling could realistically be an option for your commute to ASML.\n    <\/div>\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-list {\n  margin: 12px 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-list li {\n  margin: 6px 0;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DataExportTag":"Q30","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Is vanpool feasible for you? Vanpooling is currently available from the following pick-up locatio...","Choices":{"1":{"Display":"Yes, vanpool is feasible for me with the current pick-up locations"},"2":{"Display":"Maybe, but only if the schedule fits my working hours"},"3":{"Display":"No, the current pick-up locations are not feasible for me"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID30"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"ASML mobility experiment Thank you for participating in this survey. The purpose of this experime...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"survey-intro-container\">\n\n  <div class=\"survey-intro-title\">ASML mobility experiment<\/div>\n\n  <p class=\"survey-intro-text\">\n    Thank you for participating in this survey.\n    The purpose of this experiment is to better understand commuting preferences and evaluate potential mobility policies at ASML.\n  <\/p>\n\n  <div class=\"survey-intro-highlight\">\n    The survey takes approximately <strong>15 minutes<\/strong> to complete.\n    Your answers are anonymous and there are no right or wrong answers.\n  <\/div>\n\n  <div class=\"survey-intro-section-title\">What to expect<\/div>\n\n  <div class=\"survey-intro-grid\">\n\n    <div class=\"survey-intro-box\">\n      <div class=\"survey-intro-card-header\">\n        <h4>1. Current commute<\/h4>\n      <\/div>\n      <div class=\"survey-intro-card-body\">\n        <p>A few short questions about your current commuting situation.<\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"survey-intro-box\">\n      <div class=\"survey-intro-card-header\">\n        <h4>2. Policy choice experiment<\/h4>\n      <\/div>\n      <div class=\"survey-intro-card-body\">\n        <p>Choose a mobility policy package as if you were making decisions for ASML.<\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"survey-intro-box\">\n      <div class=\"survey-intro-card-header\">\n        <h4>3. Policy rankings<\/h4>\n      <\/div>\n      <div class=\"survey-intro-card-body\">\n        <p>Rank the policies on aspects such as effectiveness, fairness, and convenience.<\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"survey-intro-box\">\n      <div class=\"survey-intro-card-header\">\n        <h4>4. Optional feedback<\/h4>\n      <\/div>\n      <div class=\"survey-intro-card-body\">\n        <p>Share any ideas or suggestions you may have regarding mobility at ASML.<\/p>\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n  <div class=\"survey-intro-final-box\">\n    Click <strong>Next<\/strong> to start the survey.\n  <\/div>\n\n<\/div>\n\n<style>\n.survey-intro-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.survey-intro-title {\n  font-size: 36px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.survey-intro-text {\n  font-size: 21px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 18px;\n}\n\n.survey-intro-highlight {\n  font-size: 17px;\n  line-height: 1.5;\n  color: #374151;\n  background: #f3f8ff;\n  border-left: 5px solid #0072ce;\n  border-radius: 10px;\n  padding: 16px 18px;\n  margin-bottom: 28px;\n}\n\n.survey-intro-section-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: #003b8f;\n  margin: 28px 0 16px 0;\n}\n\n.survey-intro-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 22px;\n  margin-bottom: 26px;\n}\n\n.survey-intro-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.10);\n  overflow: hidden;\n}\n\n.survey-intro-card-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 15px 18px;\n}\n\n.survey-intro-card-header h4 {\n  margin: 0;\n  font-size: 21px;\n  font-weight: 800;\n  color: white;\n}\n\n.survey-intro-card-body {\n  padding: 17px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.survey-intro-card-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.survey-intro-final-box {\n  margin-top: 24px;\n  padding: 16px 18px;\n  border-radius: 14px;\n  background: #f0fdf4;\n  border: 2px solid #22c55e;\n  color: #166534;\n  font-size: 18px;\n  line-height: 1.45;\n  font-weight: 600;\n}\n\n@media only screen and (max-width: 800px) {\n  .survey-intro-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .survey-intro-title {\n    font-size: 32px;\n  }\n\n  .survey-intro-text {\n    font-size: 19px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q31","QuestionID":"QID31","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"ASML mobility experiment Thank you for participating in this survey. The purpose of this experime...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"Employee contract type Are you an employee with an ASML contract (fix) or with a contract from an...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Employee contract type<\/div>\n\n  <p class=\"ranking-question-text\">\n    Are you an employee with an ASML contract (fix) or with a contract from an external supplier (flex)?\n  <\/p>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DataExportTag":"Q32","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Employee contract type Are you an employee with an ASML contract (fix) or with a contract from an...","Choices":{"1":{"Display":"ASML contract (fix)"},"2":{"Display":"External supplier (flex)"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID32"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"Effectiveness Please rank the mobility policies based on how effective you think they would be in...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Effectiveness<\/div>\n\n  <p class=\"ranking-question-text\">\n    Please rank the mobility policies based on how effective you think they would be in reducing car use among ASML employees.\n  <\/p>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">How to answer this question<\/div>\n\n    <ol>\n      <li>Look at the list of mobility policies below.<\/li>\n      <li>Click and hold a policy.<\/li>\n      <li>Drag it up or down to change the order.<\/li>\n      <li>Put the policy you think is <strong>most effective<\/strong> at the top.<\/li>\n      <li>Put the policy you think is <strong>least effective<\/strong> at the bottom.<\/li>\n    <\/ol>\n\n    <div class=\"ranking-example-box\">\n      <div><strong>Top<\/strong> = most effective policy<\/div>\n      <div><strong>Bottom<\/strong> = least effective policy<\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"policy-help-wrapper\">\n\n    <div class=\"policy-help-reminder\">\n      Not sure what each policy means?\n    <\/div>\n\n    <button type=\"button\" class=\"policy-help-toggle\" aria-expanded=\"false\">\n      Click here to show policy descriptions again\n    <\/button>\n\n    <div class=\"policy-help-panel\" style=\"display: none;\">\n\n      <div class=\"policy-help-title\">Policy descriptions<\/div>\n\n      <div class=\"policy-help-grid\">\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking rights policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees can voluntarily give up their parking rights at ASML in exchange for one of several alternative benefits.\n              These benefits are meant to make it more attractive for employees to stop commuting by car.\n            <\/p>\n\n            <div class=\"policy-help-list-box\">\n              Employees who give up their parking rights can choose one of the following rewards:\n              <ul>\n                <li>Free e-bike<\/li>\n                <li>Unlimited public transport<\/li>\n                <li>Free EV charging point installed at home<\/li>\n                <li>\u20ac2,000 cash reward<\/li>\n              <\/ul>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking payment policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees pay a fee when they use a parking spot at ASML.\n              In the experiment, this fee can be \u20ac0, \u20ac1.50, or \u20ac3 per parking day.\n              A higher parking fee may reduce car use because commuting by car becomes less attractive.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking reservation system<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Parking priority is given to employees who live further away from ASML.\n              Employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters.\n              These employees receive priority when reserving a parking spot.\n              Employees who live closer than 20 kilometres may be encouraged to use another mode of transport, such as cycling or public transport.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>P+R reward<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees receive a financial reward when they use Park & Ride.\n              In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike.\n              This reduces the number of cars travelling directly to campus, while still offering employees a flexible way to complete their commute.\n              In the experiment, the reward can be \u20ac0, \u20ac1.50, or \u20ac3.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Emergency taxi guarantee<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees who use a vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.\n              This policy reduces the risk of being dependent on the vanpool schedule in urgent situations.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Vanpool departures<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              This policy changes how often vanpools depart.\n              In the experiment, vanpools can depart 1, 2, or 4 times per hour.\n              More frequent departures make vanpooling more flexible and may make it more attractive compared to commuting by car.\n            <\/p>\n          <\/div>\n        <\/div>\n\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 18px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box ol {\n  margin: 0 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-instruction-box li {\n  margin: 6px 0;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n.policy-help-wrapper {\n  margin: 20px 0 26px 0;\n}\n\n.policy-help-reminder {\n  font-size: 17px;\n  font-weight: 700;\n  color: #374151;\n  margin-bottom: 10px;\n}\n\n.policy-help-toggle {\n  background: linear-gradient(135deg, #003b8f, #0072ce) !important;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n  border: none !important;\n  border-radius: 10px;\n  padding: 12px 18px;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.18);\n}\n\n.policy-help-toggle:hover {\n  opacity: 0.92;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n}\n\n.policy-help-panel {\n  margin-top: 18px;\n  padding: 20px;\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: #f8fbff;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.policy-help-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 16px;\n}\n\n.policy-help-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 18px;\n}\n\n.policy-help-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 16px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n  overflow: hidden;\n}\n\n.policy-help-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 14px 16px;\n}\n\n.policy-help-header h4 {\n  margin: 0;\n  font-size: 19px;\n  font-weight: 800;\n  color: white;\n}\n\n.policy-help-body {\n  padding: 16px;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.policy-help-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.policy-help-list-box li {\n  margin: 5px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .policy-help-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q4","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Effectiveness Please rank the mobility policies based on how effective you think they would be in...","Choices":{"1":{"Display":"Parking rights policy"},"2":{"Display":"Parking payment policy"},"3":{"Display":"Parking reservation system"},"4":{"Display":"P+R reward"},"5":{"Display":"Emergency taxi guarantee"},"6":{"Display":"Vanpool departures"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID4","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n  var questionContainer = this.getQuestionContainer();\n\n  var toggleButton = questionContainer.querySelector(\".policy-help-toggle\");\n  var policyPanel = questionContainer.querySelector(\".policy-help-panel\");\n\n  if (!toggleButton || !policyPanel) {\n    return;\n  }\n\n  toggleButton.addEventListener(\"click\", function () {\n    var isHidden = policyPanel.style.display === \"none\" || policyPanel.style.display === \"\";\n\n    if (isHidden) {\n      policyPanel.style.display = \"block\";\n      toggleButton.innerText = \"Hide policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"true\");\n    } else {\n      policyPanel.style.display = \"none\";\n      toggleButton.innerText = \"Show policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"false\");\n    }\n  });\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Fairness Please rank the mobility policies based on how fair you think they are for ASML employee...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-question-title\">Fairness<\/div>\n\n<p class=\"ranking-question-text\">\n  Please rank the mobility policies based on how fair you think they are for ASML employees.\n  A fair policy is one where the costs, benefits, and restrictions are distributed in a reasonable way across different employees.\n<\/p>\n\n<p class=\"ranking-question-note\">\n  Place the policy you think is fairest at the top, and the policy you think is least fair at the bottom.\n<\/p>\n\n\n\n<div class=\"policy-help-wrapper\">\n\n  <button type=\"button\" class=\"policy-help-toggle\" aria-expanded=\"false\">\n    Show policy descriptions\n  <\/button>\n\n  <div class=\"policy-help-panel\" style=\"display: none;\">\n\n    <div class=\"policy-help-title\">Policy descriptions<\/div>\n\n    <div class=\"policy-help-grid\">\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking rights policy<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees can voluntarily give up their parking rights at ASML in exchange for one of several alternative benefits.\n            These benefits are meant to make it more attractive for employees to stop commuting by car.\n          <\/p>\n\n          <div class=\"policy-help-list-box\">\n            Employees who give up their parking rights can choose one of the following rewards:\n            <ul>\n              <li>Free e-bike<\/li>\n              <li>Unlimited public transport<\/li>\n              <li>Free EV charging point installed at home<\/li>\n              <li>\u20ac2,000 cash reward<\/li>\n            <\/ul>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking payment policy<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees pay a fee when they use a parking spot at ASML.\n            In the experiment, this fee can be \u20ac0, \u20ac1.50, or \u20ac3 per parking day.\n            A higher parking fee may reduce car use because commuting by car becomes less attractive.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking reservation system<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Parking priority is given to employees who live further away from ASML.\n            Employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters.\n            These employees receive priority when reserving a parking spot.\n            Employees who live closer than 20 kilometres may be encouraged to use another mode of transport, such as cycling or public transport.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>P+R reward<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees receive a financial reward when they use Park & Ride.\n            In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike.\n            This reduces the number of cars travelling directly to campus, while still offering employees a flexible way to complete their commute.\n            In the experiment, the reward can be \u20ac0, \u20ac1.50, or \u20ac3.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Emergency taxi guarantee<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees who use a vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.\n            This policy reduces the risk of being dependent on the vanpool schedule in urgent situations.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Vanpool departures<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            This policy changes how often vanpools depart.\n            In the experiment, vanpools can depart 1, 2, or 4 times per hour.\n            More frequent departures make vanpooling more flexible and may make it more attractive compared to commuting by car.\n          <\/p>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n.ranking-question-title {\n  font-size: 30px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n  font-family: Arial, sans-serif;\n}\n\n.ranking-question-text {\n  font-size: 19px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 10px;\n  font-family: Arial, sans-serif;\n}\n\n.ranking-question-note {\n  font-size: 16px;\n  line-height: 1.45;\n  color: #4b5563;\n  background: #f3f8ff;\n  border-left: 5px solid #0072ce;\n  border-radius: 10px;\n  padding: 12px 14px;\n  margin-bottom: 18px;\n  font-family: Arial, sans-serif;\n}\n\n.policy-help-wrapper {\n  margin: 18px 0 24px 0;\n  font-family: Arial, sans-serif;\n}\n\n.policy-help-toggle {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  border: none;\n  border-radius: 10px;\n  padding: 12px 18px;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.18);\n}\n\n.policy-help-toggle:hover {\n  opacity: 0.92;\n}\n\n.policy-help-panel {\n  margin-top: 18px;\n  padding: 18px;\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: #f8fbff;\n}\n\n.policy-help-title {\n  font-size: 24px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 16px;\n}\n\n.policy-help-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 18px;\n}\n\n.policy-help-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 16px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n  overflow: hidden;\n}\n\n.policy-help-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 14px 16px;\n}\n\n.policy-help-header h4 {\n  margin: 0;\n  font-size: 19px;\n  font-weight: 800;\n  color: white;\n}\n\n.policy-help-body {\n  padding: 16px;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.policy-help-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.policy-help-list-box li {\n  margin: 5px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .policy-help-grid {\n    grid-template-columns: 1fr;\n  }\n}\n<\/style>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n  var questionContainer = this.getQuestionContainer();\n\n  var toggleButton = questionContainer.querySelector(\".policy-help-toggle\");\n  var policyPanel = questionContainer.querySelector(\".policy-help-panel\");\n\n  if (!toggleButton || !policyPanel) {\n    return;\n  }\n\n  toggleButton.addEventListener(\"click\", function () {\n    var isHidden = policyPanel.style.display === \"none\" || policyPanel.style.display === \"\";\n\n    if (isHidden) {\n      policyPanel.style.display = \"block\";\n      toggleButton.innerText = \"Hide policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"true\");\n    } else {\n      policyPanel.style.display = \"none\";\n      toggleButton.innerText = \"Show policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"false\");\n    }\n  });\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q5","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"effectiveIneffective","Type":"likert","Reverse":false}}},"QuestionDescription":"Fairness Please rank the mobility policies based on how fair you think they are for ASML employee...","Choices":{"1":{"Display":"Parking rights policy"},"2":{"Display":"Parking payment policy"},"3":{"Display":"Parking reservation system"},"4":{"Display":"P+R reward"},"5":{"Display":"Emergency taxi guarantee"},"6":{"Display":"Vanpool departures"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID5"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Convenience Please rank the mobility policies based on how convenient you think they would be for...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-question-title\">Convenience<\/div>\n\n<p class=\"ranking-question-text\">\n  Please rank the mobility policies based on how convenient you think they would be for employees in their daily commute.\n  A convenient policy requires little extra time, effort, planning, or loss of flexibility.\n<\/p>\n\n<p class=\"ranking-question-note\">\n  Place the policy you think is most convenient at the top, and the policy you think is least convenient at the bottom.\n<\/p>\n\n\n\n<div class=\"policy-help-wrapper\">\n\n  <button type=\"button\" class=\"policy-help-toggle\" aria-expanded=\"false\">\n    Show policy descriptions\n  <\/button>\n\n  <div class=\"policy-help-panel\" style=\"display: none;\">\n\n    <div class=\"policy-help-title\">Policy descriptions<\/div>\n\n    <div class=\"policy-help-grid\">\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking rights policy<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees can voluntarily give up their parking rights at ASML in exchange for one of several alternative benefits.\n            These benefits are meant to make it more attractive for employees to stop commuting by car.\n          <\/p>\n\n          <div class=\"policy-help-list-box\">\n            Employees who give up their parking rights can choose one of the following rewards:\n            <ul>\n              <li>Free e-bike<\/li>\n              <li>Unlimited public transport<\/li>\n              <li>Free EV charging point installed at home<\/li>\n              <li>\u20ac2,000 cash reward<\/li>\n            <\/ul>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking payment policy<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees pay a fee when they use a parking spot at ASML.\n            In the experiment, this fee can be \u20ac0, \u20ac1.50, or \u20ac3 per parking day.\n            A higher parking fee may reduce car use because commuting by car becomes less attractive.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking reservation system<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Parking priority is given to employees who live further away from ASML.\n            Employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters.\n            These employees receive priority when reserving a parking spot.\n            Employees who live closer than 20 kilometres may be encouraged to use another mode of transport, such as cycling or public transport.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>P+R reward<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees receive a financial reward when they use Park & Ride.\n            In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike.\n            This reduces the number of cars travelling directly to campus, while still offering employees a flexible way to complete their commute.\n            In the experiment, the reward can be \u20ac0, \u20ac1.50, or \u20ac3.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Emergency taxi guarantee<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees who use a vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.\n            This policy reduces the risk of being dependent on the vanpool schedule in urgent situations.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Vanpool departures<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            This policy changes how often vanpools depart.\n            In the experiment, vanpools can depart 1, 2, or 4 times per hour.\n            More frequent departures make vanpooling more flexible and may make it more attractive compared to commuting by car.\n          <\/p>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n.ranking-question-title {\n  font-size: 30px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n  font-family: Arial, sans-serif;\n}\n\n.ranking-question-text {\n  font-size: 19px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 10px;\n  font-family: Arial, sans-serif;\n}\n\n.ranking-question-note {\n  font-size: 16px;\n  line-height: 1.45;\n  color: #4b5563;\n  background: #f3f8ff;\n  border-left: 5px solid #0072ce;\n  border-radius: 10px;\n  padding: 12px 14px;\n  margin-bottom: 18px;\n  font-family: Arial, sans-serif;\n}\n\n.policy-help-wrapper {\n  margin: 18px 0 24px 0;\n  font-family: Arial, sans-serif;\n}\n\n.policy-help-toggle {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  border: none;\n  border-radius: 10px;\n  padding: 12px 18px;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.18);\n}\n\n.policy-help-toggle:hover {\n  opacity: 0.92;\n}\n\n.policy-help-panel {\n  margin-top: 18px;\n  padding: 18px;\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: #f8fbff;\n}\n\n.policy-help-title {\n  font-size: 24px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 16px;\n}\n\n.policy-help-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 18px;\n}\n\n.policy-help-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 16px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n  overflow: hidden;\n}\n\n.policy-help-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 14px 16px;\n}\n\n.policy-help-header h4 {\n  margin: 0;\n  font-size: 19px;\n  font-weight: 800;\n  color: white;\n}\n\n.policy-help-body {\n  padding: 16px;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.policy-help-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.policy-help-list-box li {\n  margin: 5px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .policy-help-grid {\n    grid-template-columns: 1fr;\n  }\n}\n<\/style>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n  var questionContainer = this.getQuestionContainer();\n\n  var toggleButton = questionContainer.querySelector(\".policy-help-toggle\");\n  var policyPanel = questionContainer.querySelector(\".policy-help-panel\");\n\n  if (!toggleButton || !policyPanel) {\n    return;\n  }\n\n  toggleButton.addEventListener(\"click\", function () {\n    var isHidden = policyPanel.style.display === \"none\" || policyPanel.style.display === \"\";\n\n    if (isHidden) {\n      policyPanel.style.display = \"block\";\n      toggleButton.innerText = \"Hide policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"true\");\n    } else {\n      policyPanel.style.display = \"none\";\n      toggleButton.innerText = \"Show policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"false\");\n    }\n  });\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q6","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"effectiveIneffective","Type":"likert","Reverse":false}}},"QuestionDescription":"Convenience Please rank the mobility policies based on how convenient you think they would be for...","Choices":{"1":{"Display":"Parking rights policy"},"2":{"Display":"Parking payment policy"},"3":{"Display":"Parking reservation system"},"4":{"Display":"P+R reward"},"5":{"Display":"Emergency taxi guarantee"},"6":{"Display":"Vanpool departures"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID6"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Personal support Please rank the mobility policies based on how much you personally support ASML...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-question-title\">Personal support<\/div>\n\n<p class=\"ranking-question-text\">\n  Please rank the mobility policies based on how much you personally support ASML implementing them.\n  This is about your overall opinion of each policy, considering both its advantages and disadvantages.\n<\/p>\n\n<p class=\"ranking-question-note\">\n  Place the policy you support most at the top, and the policy you support least at the bottom.\n<\/p>\n\n\n\n<div class=\"policy-help-wrapper\">\n\n  <button type=\"button\" class=\"policy-help-toggle\" aria-expanded=\"false\">\n    Show policy descriptions\n  <\/button>\n\n  <div class=\"policy-help-panel\" style=\"display: none;\">\n\n    <div class=\"policy-help-title\">Policy descriptions<\/div>\n\n    <div class=\"policy-help-grid\">\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking rights policy<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees can voluntarily give up their parking rights at ASML in exchange for one of several alternative benefits.\n            These benefits are meant to make it more attractive for employees to stop commuting by car.\n          <\/p>\n\n          <div class=\"policy-help-list-box\">\n            Employees who give up their parking rights can choose one of the following rewards:\n            <ul>\n              <li>Free e-bike<\/li>\n              <li>Unlimited public transport<\/li>\n              <li>Free EV charging point installed at home<\/li>\n              <li>\u20ac2,000 cash reward<\/li>\n            <\/ul>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking payment policy<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees pay a fee when they use a parking spot at ASML.\n            In the experiment, this fee can be \u20ac0, \u20ac1.50, or \u20ac3 per parking day.\n            A higher parking fee may reduce car use because commuting by car becomes less attractive.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Parking reservation system<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Parking priority is given to employees who live further away from ASML.\n            Employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters.\n            These employees receive priority when reserving a parking spot.\n            Employees who live closer than 20 kilometres may be encouraged to use another mode of transport, such as cycling or public transport.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>P+R reward<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees receive a financial reward when they use Park & Ride.\n            In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike.\n            This reduces the number of cars travelling directly to campus, while still offering employees a flexible way to complete their commute.\n            In the experiment, the reward can be \u20ac0, \u20ac1.50, or \u20ac3.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Emergency taxi guarantee<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            Employees who use a vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.\n            This policy reduces the risk of being dependent on the vanpool schedule in urgent situations.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"policy-help-box\">\n        <div class=\"policy-help-header\">\n          <h4>Vanpool departures<\/h4>\n        <\/div>\n        <div class=\"policy-help-body\">\n          <p>\n            This policy changes how often vanpools depart.\n            In the experiment, vanpools can depart 1, 2, or 4 times per hour.\n            More frequent departures make vanpooling more flexible and may make it more attractive compared to commuting by car.\n          <\/p>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n.ranking-question-title {\n  font-size: 30px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n  font-family: Arial, sans-serif;\n}\n\n.ranking-question-text {\n  font-size: 19px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 10px;\n  font-family: Arial, sans-serif;\n}\n\n.ranking-question-note {\n  font-size: 16px;\n  line-height: 1.45;\n  color: #4b5563;\n  background: #f3f8ff;\n  border-left: 5px solid #0072ce;\n  border-radius: 10px;\n  padding: 12px 14px;\n  margin-bottom: 18px;\n  font-family: Arial, sans-serif;\n}\n\n.policy-help-wrapper {\n  margin: 18px 0 24px 0;\n  font-family: Arial, sans-serif;\n}\n\n.policy-help-toggle {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  border: none;\n  border-radius: 10px;\n  padding: 12px 18px;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.18);\n}\n\n.policy-help-toggle:hover {\n  opacity: 0.92;\n}\n\n.policy-help-panel {\n  margin-top: 18px;\n  padding: 18px;\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: #f8fbff;\n}\n\n.policy-help-title {\n  font-size: 24px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 16px;\n}\n\n.policy-help-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 18px;\n}\n\n.policy-help-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 16px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n  overflow: hidden;\n}\n\n.policy-help-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 14px 16px;\n}\n\n.policy-help-header h4 {\n  margin: 0;\n  font-size: 19px;\n  font-weight: 800;\n  color: white;\n}\n\n.policy-help-body {\n  padding: 16px;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.policy-help-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.policy-help-list-box li {\n  margin: 5px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .policy-help-grid {\n    grid-template-columns: 1fr;\n  }\n}\n<\/style>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n  var questionContainer = this.getQuestionContainer();\n\n  var toggleButton = questionContainer.querySelector(\".policy-help-toggle\");\n  var policyPanel = questionContainer.querySelector(\".policy-help-panel\");\n\n  if (!toggleButton || !policyPanel) {\n    return;\n  }\n\n  toggleButton.addEventListener(\"click\", function () {\n    var isHidden = policyPanel.style.display === \"none\" || policyPanel.style.display === \"\";\n\n    if (isHidden) {\n      policyPanel.style.display = \"block\";\n      toggleButton.innerText = \"Hide policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"true\");\n    } else {\n      policyPanel.style.display = \"none\";\n      toggleButton.innerText = \"Show policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"false\");\n    }\n  });\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q7","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"effectiveIneffective","Type":"likert","Reverse":false}}},"QuestionDescription":"Personal support Please rank the mobility policies based on how much you personally support ASML...","Choices":{"1":{"Display":"Parking rights policy"},"2":{"Display":"Parking payment policy"},"3":{"Display":"Parking reservation system"},"4":{"Display":"P+R reward"},"5":{"Display":"Emergency taxi guarantee"},"6":{"Display":"Vanpool departures"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID7"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Fairness Please rank the mobility policies based on how fair you think they are for ASML employee...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-question-title\">Fairness<\/div>\n\n<p class=\"ranking-question-text\">\n  Please rank the mobility policies based on how fair you think they are for ASML employees.\n  A fair policy is one where the costs, benefits, and restrictions are distributed in a reasonable way across different employees.\n<\/p>\n\n<div class=\"ranking-instruction-box\">\n  <div class=\"ranking-instruction-title\">How to answer this question<\/div>\n\n  <ol>\n    <li>Look at the list of mobility policies below.<\/li>\n    <li>Click and hold a policy.<\/li>\n    <li>Drag it up or down to change the order.<\/li>\n    <li>Put the policy you think is <strong>fairest<\/strong> at the top.<\/li>\n    <li>Put the policy you think is <strong>least fair<\/strong> at the bottom.<\/li>\n  <\/ol>\n\n  <div class=\"ranking-example-box\">\n    <div><strong>Top<\/strong> = fairest policy<\/div>\n    <div><strong>Bottom<\/strong> = least fair policy<\/div>\n  <\/div>\n<\/div>\n\n  <div class=\"policy-help-wrapper\">\n\n    <div class=\"policy-help-reminder\">\n      Not sure what each policy means?\n    <\/div>\n\n    <button type=\"button\" class=\"policy-help-toggle\" aria-expanded=\"false\">\n      Click here to show policy descriptions again\n    <\/button>\n\n    <div class=\"policy-help-panel\" style=\"display: none;\">\n\n      <div class=\"policy-help-title\">Policy descriptions<\/div>\n\n      <div class=\"policy-help-grid\">\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking rights policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees can voluntarily give up their parking rights at ASML in exchange for one of several alternative benefits.\n              These benefits are meant to make it more attractive for employees to stop commuting by car.\n            <\/p>\n\n            <div class=\"policy-help-list-box\">\n              Employees who give up their parking rights can choose one of the following rewards:\n              <ul>\n                <li>Free e-bike<\/li>\n                <li>Unlimited public transport<\/li>\n                <li>Free EV charging point installed at home<\/li>\n                <li>\u20ac2,000 cash reward<\/li>\n              <\/ul>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking payment policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees pay a fee when they use a parking spot at ASML.\n              In the experiment, this fee can be \u20ac0, \u20ac1.50, or \u20ac3 per parking day.\n              A higher parking fee may reduce car use because commuting by car becomes less attractive.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking reservation system<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Parking priority is given to employees who live further away from ASML.\n              Employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters.\n              These employees receive priority when reserving a parking spot.\n              Employees who live closer than 20 kilometres may be encouraged to use another mode of transport, such as cycling or public transport.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>P+R reward<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees receive a financial reward when they use Park & Ride.\n              In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike.\n              This reduces the number of cars travelling directly to campus, while still offering employees a flexible way to complete their commute.\n              In the experiment, the reward can be \u20ac0, \u20ac1.50, or \u20ac3.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Emergency taxi guarantee<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees who use a vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.\n              This policy reduces the risk of being dependent on the vanpool schedule in urgent situations.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Vanpool departures<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              This policy changes how often vanpools depart.\n              In the experiment, vanpools can depart 1, 2, or 4 times per hour.\n              More frequent departures make vanpooling more flexible and may make it more attractive compared to commuting by car.\n            <\/p>\n          <\/div>\n        <\/div>\n\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 18px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box ol {\n  margin: 0 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-instruction-box li {\n  margin: 6px 0;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n.policy-help-wrapper {\n  margin: 20px 0 26px 0;\n}\n\n.policy-help-reminder {\n  font-size: 17px;\n  font-weight: 700;\n  color: #374151;\n  margin-bottom: 10px;\n}\n\n.policy-help-toggle {\n  background: linear-gradient(135deg, #003b8f, #0072ce) !important;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n  border: none !important;\n  border-radius: 10px;\n  padding: 12px 18px;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.18);\n}\n\n.policy-help-toggle:hover {\n  opacity: 0.92;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n}\n\n.policy-help-panel {\n  margin-top: 18px;\n  padding: 20px;\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: #f8fbff;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.policy-help-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 16px;\n}\n\n.policy-help-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 18px;\n}\n\n.policy-help-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 16px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n  overflow: hidden;\n}\n\n.policy-help-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 14px 16px;\n}\n\n.policy-help-header h4 {\n  margin: 0;\n  font-size: 19px;\n  font-weight: 800;\n  color: white;\n}\n\n.policy-help-body {\n  padding: 16px;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.policy-help-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.policy-help-list-box li {\n  margin: 5px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .policy-help-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n  var questionContainer = this.getQuestionContainer();\n\n  var toggleButton = questionContainer.querySelector(\".policy-help-toggle\");\n  var policyPanel = questionContainer.querySelector(\".policy-help-panel\");\n\n  if (!toggleButton || !policyPanel) {\n    return;\n  }\n\n  toggleButton.addEventListener(\"click\", function () {\n    var isHidden = policyPanel.style.display === \"none\" || policyPanel.style.display === \"\";\n\n    if (isHidden) {\n      policyPanel.style.display = \"block\";\n      toggleButton.innerText = \"Hide policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"true\");\n    } else {\n      policyPanel.style.display = \"none\";\n      toggleButton.innerText = \"Show policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"false\");\n    }\n  });\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q8","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Fairness Please rank the mobility policies based on how fair you think they are for ASML employee...","Choices":{"1":{"Display":"Parking rights policy"},"2":{"Display":"Parking payment policy"},"3":{"Display":"Parking reservation system"},"4":{"Display":"P+R reward"},"5":{"Display":"Emergency taxi guarantee"},"6":{"Display":"Vanpool departures"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID8"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q9","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID9"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}