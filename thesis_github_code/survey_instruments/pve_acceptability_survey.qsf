  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.08) !important;\n}\n\n.Skin .QuestionBody textarea:focus,\n.Skin .QuestionBody input[type=\"text\"]:focus {\n  outline: none !important;\n  border-color: #0072ce !important;\n  background: white !important;\n}\n\n@media only screen and (max-width: 800px) {\n  .open-question-title {\n    font-size: 30px;\n  }\n\n  .open-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>\n\n<div class=\"open-question-container\">\n\n  <div class=\"open-question-title\">Barriers to sustainable commuting (optional)<\/div>\n\n  <p class=\"open-question-text\">\n    Is there anything that currently prevents you from using a more sustainable travel option more often?\n  <\/p>\n\n  <div class=\"open-question-box\">\n    <div class=\"open-question-box-title\">Please explain the main barrier<\/div>\n\n    <p>\n      Think about options such as cycling, public transport, P+R, vanpooling, or carpooling.\n      If there is a barrier, please explain what would need to change for you to consider using that option more often.\n    <\/p>\n\n    <div class=\"open-question-example-box\">\n      Examples: travel time, distance, safety, flexibility, costs, bad connections, lack of facilities, unpredictable working hours, or personal circumstances.\n    <\/div>\n  <\/div>\n\n<\/div>","DefaultChoices":false,"DataExportTag":"Q16","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Barriers to sustainable commuting (optional) Is there anything that currently prevents you from u...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID16"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Anything else? Is there anything else you would like to share about commuting to ASML or the mobi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<style>\n.open-question-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.open-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.open-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.open-question-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.open-question-box-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.open-question-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.open-question-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n\/* Optional: styles the Qualtrics text entry box *\/\n.Skin .QuestionBody textarea,\n.Skin .QuestionBody input[type=\"text\"] {\n  width: 100% !important;\n  min-height: 120px !important;\n  border: 2px solid #d7e6ff !important;\n  border-radius: 14px !important;\n  background: #f8fbff !important;\n  padding: 14px !important;\n  font-size: 16px !important;\n  font-family: Arial, sans-serif !important;\n  color: #374151 !important;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.08) !important;\n}\n\n.Skin .QuestionBody textarea:focus,\n.Skin .QuestionBody input[type=\"text\"]:focus {\n  outline: none !important;\n  border-color: #0072ce !important;\n  background: white !important;\n}\n\n@media only screen and (max-width: 800px) {\n  .open-question-title {\n    font-size: 30px;\n  }\n\n  .open-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>\n\n<div class=\"open-question-container\">\n\n  <div class=\"open-question-title\">Anything else?<\/div>\n\n  <p class=\"open-question-text\">\n    Is there anything else you would like to share about commuting to ASML or the mobility policies discussed in this survey?\n  <\/p>\n\n  <div class=\"open-question-box\">\n    <div class=\"open-question-box-title\">Optional final comment<\/div>\n\n    <p>\n      You can use this space for any additional thoughts, suggestions, concerns, or ideas that were not covered in the previous questions.\n    <\/p>\n\n    <div class=\"open-question-example-box\">\n      You can leave this question empty if you have nothing else to add.\n    <\/div>\n  <\/div>\n\n<\/div>","DefaultChoices":false,"DataExportTag":"Q17","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Anything else? Is there anything else you would like to share about commuting to ASML or the mobi...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID17"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"Your commuting experience (optional) You have now shared how you view the different mobility poli...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Your commuting experience (optional)<\/div>\n\n  <p class=\"ranking-question-text\">\n    You have now shared how you view the different mobility policies.\n    In the final part of the survey, we would like to hear more about your own commuting experience.\n  <\/p>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">Your ideas can help improve mobility at ASML<\/div>\n\n    <p>\n      The next questions are open questions.\n      Please share any thoughts, concerns, or suggestions that could help ASML make commuting easier, less stressful, or more sustainable.\n    <\/p>\n  <\/div>\n\n<\/div>\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n<\/style>\n\n","DefaultChoices":false,"DataExportTag":"Q18","QuestionID":"QID18","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Your commuting experience (optional) You have now shared how you view the different mobility poli...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"Main ASML work location At which ASML location do you mainly work?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Main ASML work location<\/div>\n\n  <p class=\"ranking-question-text\">\n    At which ASML location do you mainly work?\n  <\/p>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q19","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Main ASML work location At which ASML location do you mainly work?","Choices":{"1":{"Display":"On campus (De Run 6000\/1000)"},"2":{"Display":"Another location"},"3":{"Display":"High Tech Campus"},"4":{"Display":"Flight Forum"},"5":{"Display":"BIC"}},"ChoiceOrder":[1,"3","4","5",2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID19"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Choose your policy package Select a policy package. The predicted modal split updates automatical...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"pve-container\">\n<div class=\"pve-title\">Choose your policy package<\/div>\n\n<div class=\"pve-intro\">Select a policy package. The predicted modal split updates automatically.<\/div>\n\n<div class=\"pve-main-layout\">\n<div class=\"pve-grid\">\n<div class=\"pve-box\">\n<div class=\"pve-card-header\">\n<h4>Parking rights policy<\/h4>\n<\/div>\n\n<div class=\"pve-card-body\">\n<p class=\"pve-description\">Employees can voluntarily give up parking rights in exchange for alternative benefits.<\/p>\n<select id=\"parkingRights\"><option value=\"off\">Do not introduce policy<\/option><option value=\"on\">Introduce policy<\/option> <\/select><\/div>\n<\/div>\n\n<div class=\"pve-box\">\n<div class=\"pve-card-header\">\n<h4>Parking payment policy<\/h4>\n<\/div>\n\n<div class=\"pve-card-body\">\n<p class=\"pve-description\">Employees pay a fee when using a parking spot at ASML.<\/p>\n<select id=\"parkingCost\"><option value=\"0\">&euro;0<\/option><option value=\"1.5\">&euro;1.50<\/option><option value=\"3\">&euro;3<\/option> <\/select><\/div>\n<\/div>\n\n<div class=\"pve-box\">\n<div class=\"pve-card-header\">\n<h4>Parking reservation system<\/h4>\n<\/div>\n\n<div class=\"pve-card-body\">\n<p class=\"pve-description\">Parking priority is given to employees who live further away.<\/p>\n<select id=\"parkingReservation\"><option value=\"0\">No priority system<\/option><option value=\"1\">Priority system<\/option> <\/select><\/div>\n<\/div>\n\n<div class=\"pve-box\">\n<div class=\"pve-card-header\">\n<h4>P+R reward<\/h4>\n<\/div>\n\n<div class=\"pve-card-body\">\n<p class=\"pve-description\">Employees receive a reward when using Park &amp; Ride.<\/p>\n<select id=\"prReward\"><option value=\"0\">&euro;0<\/option><option value=\"1.5\">&euro;1.50<\/option><option value=\"3\">&euro;3<\/option> <\/select><\/div>\n<\/div>\n\n<div class=\"pve-box\">\n<div class=\"pve-card-header\">\n<h4>Emergency taxi guarantee<\/h4>\n<\/div>\n\n<div class=\"pve-card-body\">\n<p class=\"pve-description\">Vanpool users are guaranteed an emergency taxi when needed.<\/p>\n<select id=\"vpTaxi\"><option value=\"0\">No guarantee<\/option><option value=\"1\">Guarantee<\/option> <\/select><\/div>\n<\/div>\n\n<div class=\"pve-box\">\n<div class=\"pve-card-header\">\n<h4>Vanpool departures<\/h4>\n<\/div>\n\n<div class=\"pve-card-body\">\n<p class=\"pve-description\">Number of vanpool departures per hour.<\/p>\n<select id=\"vpFreq\"><option value=\"1\">1 per hour<\/option><option value=\"2\">2 per hour<\/option><option value=\"4\">4 per hour<\/option> <\/select><\/div>\n<\/div>\n<\/div>\n\n<div id=\"split-box\">\n<div class=\"side-score-title\">Predicted modal split<\/div>\n\n<div id=\"pieChart\">&nbsp;<\/div>\n\n<div class=\"legend-row\">\n  <span class=\"dot car\"><\/span>\n  <span id=\"labelCar\">Car:<\/span>\n  <strong><span id=\"carShare\">0<\/span>%<\/strong>\n<\/div>\n\n<div class=\"legend-row\">\n  <span class=\"dot bike\"><\/span>\n  <span id=\"labelBike\">Bike:<\/span>\n  <strong><span id=\"bikeShare\">0<\/span>%<\/strong>\n<\/div>\n\n<div class=\"legend-row\">\n  <span class=\"dot pt\"><\/span>\n  <span id=\"labelPT\">Public transport:<\/span>\n  <strong><span id=\"ptShare\">0<\/span>%<\/strong>\n<\/div>\n\n<\/div>\n<\/div>\n<style type=\"text\/css\">#pve-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.pve-title {\n  font-size: 36px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 8px;\n}\n\n.pve-intro {\n  font-size: 22px;\n  line-height: 1.4;\n  color: #4b5563;\n  margin-bottom: 24px;\n}\n\n.pve-main-layout {\n  display: block;\n  padding-right: 190px;\n}\n\n.pve-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 22px;\n}\n\n.pve-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.10);\n  overflow: hidden;\n}\n\n.pve-card-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 16px 18px;\n}\n\n.pve-card-header h4 {\n  margin: 0;\n  font-size: 22px;\n  font-weight: 800;\n  color: white;\n}\n\n.pve-card-body {\n  padding: 18px;\n}\n\n.pve-description {\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n  min-height: 70px;\n  margin-bottom: 16px;\n}\n\t\n.asterisk {\n  color: #ef4444;\n  font-weight: 900;\n}\n\n.disclaimer {\n  margin-top: 10px;\n  font-size: 12px;\n  color: #ef4444;\n  line-height: 1.3;\n}\n\n.pve-box select {\n  width: 100%;\n  padding: 10px;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 8px;\n  font-size: 16px;\n  background-color: #f8fbff;\n}\n\n#split-box {\n  position: fixed;\n  top: 190px;\n  right: 90px;\n  width: 190px;\n  padding: 18px;\n  border: 3px solid #0072ce;\n  border-radius: 18px;\n  background: #f3f8ff;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);\n  text-align: center;\n  z-index: 9999;\n}\n\n.side-score-title {\n  font-size: 17px;\n  font-weight: 800;\n  color: #1f2937;\n  margin-bottom: 14px;\n}\n\n#pieChart {\n  width: 145px;\n  height: 145px;\n  border-radius: 50%;\n  margin: 0 auto 16px auto;\n  background: conic-gradient(#003b8f 0% 40%, #76b82a 40% 65%, #00a3e0 65% 100%);\n  border: 2px solid white;\n}\n\n.legend-row {\n  font-size: 14px;\n  text-align: left;\n  margin: 8px 0;\n}\n\t#labelCar, #labelBike, #labelPT {\n  color: #1f2937; \/* black\/dark gray *\/\n  font-weight: normal;\n}\n\n\n.dot {\n  display: inline-block;\n  width: 11px;\n  height: 11px;\n  border-radius: 50%;\n  margin-right: 7px;\n}\n\n.dot.car { background: #003b8f; }\n.dot.bike { background: #76b82a; }\n.dot.pt { background: #00a3e0; }\n\n#reductionBox {\n  margin-top: 14px;\n  padding: 12px;\n  border-radius: 12px;\n  background: #fee2e2; \/* start red *\/\n  border: 2px solid #ef4444;\n  font-size: 14px;\n  text-align: center;\n  transition: all 0.3s ease;\n}\n\n@media only screen and (max-width: 900px) {\n  .pve-main-layout {\n    padding-right: 0;\n  }\n\n  #split-box {\n    position: relative;\n    top: auto;\n    right: auto;\n    width: auto;\n    margin-bottom: 22px;\n  }\n}\n\n@media only screen and (max-width: 700px) {\n  .pve-grid {\n    grid-template-columns: 1fr;\n  }\n}\n<\/style>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Choose your policy package Select a policy package. The predicted modal split updates automatical...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n\n  var coeffs = {\n    off: {\n      ASC_CAR: 0,\n      ASC_PR: -2.869257,\n      ASC_VP: -1.346073,\n      ASC_PT: -2.447010,\n      ASC_BIKE: 0.895388,\n      B_PARK_COST: -0.103885,\n      B_PARK_GUAR: 0.294532,\n      B_PR_REWARD: 0.291291,\n      B_VP_TAXI: 0.754370,\n      B_VP_FREQ: 0.218550\n    },\n    on: {\n      ASC_CAR: 0,\n      ASC_PR: -1.592105,\n      ASC_VP: -1.461592,\n      ASC_PT: -2.128902,\n      ASC_BIKE: 1.045520,\n      B_PARK_COST: -0.079901,\n      B_PARK_GUAR: 0.247283,\n      B_PR_REWARD: 0.087732,\n      B_VP_TAXI: 0.518001,\n      B_VP_FREQ: 0.338595\n    }\n  };\n\n  var availabilityProfiles = [\n    {car_av: 1, pr_av: 1, vanpool_av: 0, pt_av: 1, bike_av: 1, weight: 0.628399},\n    {car_av: 1, pr_av: 1, vanpool_av: 0, pt_av: 1, bike_av: 0, weight: 0.290030},\n    {car_av: 1, pr_av: 1, vanpool_av: 1, pt_av: 1, bike_av: 0, weight: 0.072508},\n    {car_av: 1, pr_av: 1, vanpool_av: 1, pt_av: 1, bike_av: 1, weight: 0.009063}\n  ];\n\nvar container = this.getQuestionContainer();\n\nvar fields = {\n  parkingRights: container.querySelector(\"#parkingRights\"),\n  parkingCost: container.querySelector(\"#parkingCost\"),\n  parkingReservation: container.querySelector(\"#parkingReservation\"),\n  prReward: container.querySelector(\"#prReward\"),\n  vpTaxi: container.querySelector(\"#vpTaxi\"),\n  vpFreq: container.querySelector(\"#vpFreq\")\n};\n\n  var nextButton = document.getElementById(\"NextButton\");\n\n  function saveEmbeddedData(name, value) {\n    if (Qualtrics.SurveyEngine.setEmbeddedData) {\n      Qualtrics.SurveyEngine.setEmbeddedData(name, String(value));\n    }\n  }\n\n  function getSelectedText(selectElement) {\n    return selectElement.options[selectElement.selectedIndex].text;\n  }\n\n  function setNextButtonAllowed(allowed) {\n    if (!nextButton) return;\n    nextButton.disabled = !allowed;\n    nextButton.style.opacity = allowed ? \"1\" : \"0.45\";\n    nextButton.style.cursor = allowed ? \"pointer\" : \"not-allowed\";\n  }\n\n  function calculateProbabilities(c, x, av) {\n\n    var V_car = c.ASC_CAR + c.B_PARK_COST * x.parkingCost + c.B_PARK_GUAR * x.parkingGuaranteed;\n    var V_pr = c.ASC_PR + c.B_PR_REWARD * x.prReward;\n    var V_vp = c.ASC_VP + c.B_VP_TAXI * x.vpTaxi + c.B_VP_FREQ * x.vpFreq;\n    var V_pt = c.ASC_PT;\n    var V_bike = c.ASC_BIKE;\n\n    var availableUtilities = [];\n\n    if (av.car_av === 1) availableUtilities.push(V_car);\n    if (av.pr_av === 1) availableUtilities.push(V_pr);\n    if (av.vanpool_av === 1) availableUtilities.push(V_vp);\n    if (av.pt_av === 1) availableUtilities.push(V_pt);\n    if (av.bike_av === 1) availableUtilities.push(V_bike);\n\n    var maxV = Math.max.apply(null, availableUtilities);\n\n    var expCar = av.car_av === 1 ? Math.exp(V_car - maxV) : 0;\n    var expPr = av.pr_av === 1 ? Math.exp(V_pr - maxV) : 0;\n    var expVp = av.vanpool_av === 1 ? Math.exp(V_vp - maxV) : 0;\n    var expPt = av.pt_av === 1 ? Math.exp(V_pt - maxV) : 0;\n    var expBike = av.bike_av === 1 ? Math.exp(V_bike - maxV) : 0;\n\n    var denom = expCar + expPr + expVp + expPt + expBike;\n\n    return {\n      car: expCar \/ denom,\n      pr: expPr \/ denom,\n      vanpool: expVp \/ denom,\n      pt: expPt \/ denom,\n      bike: expBike \/ denom\n    };\n  }\n\n  function calculatePopulationAverage(c, x) {\n    var total = { car: 0, pr: 0, vanpool: 0, pt: 0, bike: 0 };\n\n    availabilityProfiles.forEach(function (profile) {\n      var p = calculateProbabilities(c, x, profile);\n      total.car += profile.weight * p.car;\n      total.pr += profile.weight * p.pr;\n      total.vanpool += profile.weight * p.vanpool;\n      total.pt += profile.weight * p.pt;\n      total.bike += profile.weight * p.bike;\n    });\n\n    return total;\n  }\n\n  function averageProbabilities(p1, p2, w1, w2) {\n    return {\n      car: w1 * p1.car + w2 * p2.car,\n      pr: w1 * p1.pr + w2 * p2.pr,\n      vanpool: w1 * p1.vanpool + w2 * p2.vanpool,\n      pt: w1 * p1.pt + w2 * p2.pt,\n      bike: w1 * p1.bike + w2 * p2.bike\n    };\n  }\n\n  function updateReductionBox(carShare) {\n    var reduction = (0.50 - carShare) * 100;\n    var el = document.getElementById(\"reductionValue\");\nif (el) {\n  el.innerText = reduction.toFixed(1);\n}\n    setNextButtonAllowed(reduction >= 1);\n    saveEmbeddedData(\"pve_car_reduction_pp\", reduction.toFixed(3));\n  }\n\n  function getAdjustedModalSplit(probs, baselineProbs) {\n    var base = { car: 0.50, bike: 0.35, pt: 0.15 };\n    var carEffect = (probs.car - baselineProbs.car) \/ baselineProbs.car;\n    var newCar = base.car * (1 + carEffect);\n    var delta = base.car - newCar;\n    return {\n      car: newCar,\n      bike: base.bike + delta * 0.7,\n      pt: base.pt + delta * 0.3\n    };\n  }\n\n  function getColorForCarShare(carShare) {\n    var pct = carShare * 100;\n    if (pct >= 45) return \"#ef4444\";\n    if (pct >= 40) return \"#f59e0b\";\n    return \"#22c55e\";\n  }\n\n  function updateModelSplit() {\n\n    var parkingRights = fields.parkingRights.value;\n    var c = coeffs[parkingRights];\n\n    var parkingCost = Number(fields.parkingCost.value);\n    var parkingReservation = Number(fields.parkingReservation.value);\n    var prReward = Number(fields.prReward.value);\n    var vpTaxi = Number(fields.vpTaxi.value);\n    var vpFreq = Number(fields.vpFreq.value);\n\n    \/\/ \u00e2\u0153\u2026 \u00e2\u0153\u2026 \u00e2\u0153\u2026 NEW: SAVE EARLY (main fix)\n    saveEmbeddedData(\"pve_parking_rights_policy\", parkingRights);\n    saveEmbeddedData(\"pve_parking_rights_policy_label\", getSelectedText(fields.parkingRights));\n\n    saveEmbeddedData(\"pve_parking_cost\", parkingCost);\n    saveEmbeddedData(\"pve_parking_cost_label\", getSelectedText(fields.parkingCost));\n\n    saveEmbeddedData(\"pve_parking_reservation\", parkingReservation);\n    saveEmbeddedData(\"pve_parking_reservation_label\", getSelectedText(fields.parkingReservation));\n\n    saveEmbeddedData(\"pve_pr_reward\", prReward);\n    saveEmbeddedData(\"pve_pr_reward_label\", getSelectedText(fields.prReward));\n\n    saveEmbeddedData(\"pve_vp_taxi\", vpTaxi);\n    saveEmbeddedData(\"pve_vp_taxi_label\", getSelectedText(fields.vpTaxi));\n\n    saveEmbeddedData(\"pve_vp_frequency\", vpFreq);\n    saveEmbeddedData(\"pve_vp_frequency_label\", getSelectedText(fields.vpFreq));\n\n    var probs;\n\n    if (parkingReservation === 1) {\n      var xGuaranteed = { parkingCost, parkingGuaranteed: 1, prReward, vpTaxi, vpFreq };\n      var xNotGuaranteed = { parkingCost, parkingGuaranteed: 0, prReward, vpTaxi, vpFreq };\n\n      var probsG = calculatePopulationAverage(c, xGuaranteed);\n      var probsNG = calculatePopulationAverage(c, xNotGuaranteed);\n\n      probs = averageProbabilities(probsG, probsNG, 0.5, 0.5);\n\n    } else {\n      var xBase = { parkingCost, parkingGuaranteed: 1, prReward, vpTaxi, vpFreq };\n      probs = calculatePopulationAverage(c, xBase);\n    }\n\n    var baselineProbs = calculatePopulationAverage(coeffs.off, {\n      parkingCost: 0,\n      parkingGuaranteed: 1,\n      prReward: 0,\n      vpTaxi: 0,\n      vpFreq: 1\n    });\n\n    var adjusted = getAdjustedModalSplit(probs, baselineProbs);\n\n    var carShare = adjusted.car;\n    var bikeShare = adjusted.bike;\n    var publicTransportShare = adjusted.pt;\n\n    var carPct = Math.round(carShare * 100);\n    var bikePct = Math.round(bikeShare * 100);\n    var ptPct = 100 - carPct - bikePct;\n\n    document.getElementById(\"carShare\").innerText = carPct;\n    document.getElementById(\"bikeShare\").innerText = bikePct;\n    document.getElementById(\"ptShare\").innerText = ptPct;\n\n    var color = getColorForCarShare(carShare);\n    document.getElementById(\"carShare\").style.color = color;\n    document.getElementById(\"bikeShare\").style.color = color;\n    document.getElementById(\"ptShare\").style.color = color;\n\n    document.getElementById(\"labelCar\").style.color = \"#1f2937\";\n    document.getElementById(\"labelBike\").style.color = \"#1f2937\";\n    document.getElementById(\"labelPT\").style.color = \"#1f2937\";\n\n    var pieChart = document.getElementById(\"pieChart\");\n    pieChart.style.background =\n      \"conic-gradient(#003b8f 0% \" + carPct + \"%, #76b82a \" +\n      carPct + \"% \" + (carPct + bikePct) + \"%, #00a3e0 \" +\n      (carPct + bikePct) + \"% 100%)\";\n\n    updateReductionBox(carShare);\n\n    \/\/ (probabilities + shares unchanged)\n    saveEmbeddedData(\"pve_prob_car\", probs.car.toFixed(6));\n    saveEmbeddedData(\"pve_prob_pr\", probs.pr.toFixed(6));\n    saveEmbeddedData(\"pve_prob_vanpool\", probs.vanpool.toFixed(6));\n    saveEmbeddedData(\"pve_prob_pt\", probs.pt.toFixed(6));\n    saveEmbeddedData(\"pve_prob_bike\", probs.bike.toFixed(6));\n\n    saveEmbeddedData(\"pve_share_car_grouped\", carShare.toFixed(6));\n    saveEmbeddedData(\"pve_share_bike_grouped\", bikeShare.toFixed(6));\n    saveEmbeddedData(\"pve_share_public_transport_grouped\", publicTransportShare.toFixed(6));\n\n    saveEmbeddedData(\"pve_share_car_percent\", carPct);\n    saveEmbeddedData(\"pve_share_bike_percent\", bikePct);\n    saveEmbeddedData(\"pve_share_public_transport_percent\", ptPct);\n  }\n\n  Object.keys(fields).forEach(function (key) {\n    fields[key].addEventListener(\"change\", updateModelSplit);\n  });\n\n  updateModelSplit();\n\n  Qualtrics.SurveyEngine.addOnPageSubmit(function () {\n    updateModelSplit();\n  });\n\n});","QuestionText_Unsafe":"<style>\n  #pve-container {\n    max-width: 1050px;\n    margin: 0 auto;\n    font-family: Arial, sans-serif;\n    color: #1f2937;\n  }\n\n  .pve-title {\n    font-size: 36px;\n    font-weight: 800;\n    color: #003b8f;\n    margin-bottom: 8px;\n  }\n\n  .pve-intro {\n    font-size: 22px;\n    line-height: 1.4;\n    color: #4b5563;\n    margin-bottom: 24px;\n  }\n\n  .pve-main-layout {\n    display: block;\n    padding-right: 120px;\n  }\n\n  .pve-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(260px, 1fr));\n    gap: 22px;\n  }\n\n  .pve-box {\n    border: 2px solid #d7e6ff;\n    border-radius: 18px;\n    background: #ffffff;\n    box-shadow: 0 4px 12px rgba(0, 59, 143, 0.10);\n    overflow: hidden;\n  }\n\n  .pve-card-header {\n    background: linear-gradient(135deg, #003b8f, #0072ce);\n    color: white;\n    padding: 16px 18px;\n  }\n\n  .pve-card-header h4 {\n    margin: 0;\n    font-size: 24px;\n    font-weight: 800;\n    color: white;\n  }\n\n  .pve-card-body {\n    padding: 18px;\n  }\n\n  .pve-description {\n    font-size: 15px;\n    line-height: 1.45;\n    color: #374151;\n    background: #f3f8ff;\n    border-left: 4px solid #0072ce;\n    border-radius: 8px;\n    padding: 12px 14px;\n    min-height: 80px;\n    margin-bottom: 16px;\n  }\n\n  .pve-box select {\n    width: 100%;\n    padding: 10px;\n    border: 1.5px solid #b9d4f8;\n    border-radius: 8px;\n    font-size: 16px;\n    background-color: #f8fbff;\n    margin-bottom: 14px;\n  }\n\n  .score-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    background: #eef6ff;\n    border-radius: 10px;\n    padding: 10px 12px;\n    font-size: 16px;\n  }\n\n  .score-badge {\n    background: #0072ce;\n    color: white;\n    border-radius: 999px;\n    padding: 6px 14px;\n    font-weight: 800;\n    min-width: 34px;\n    text-align: center;\n  }\n\n  #side-score-box {\n    position: fixed;\n    top: 200px;\n    right: 130px;\n    width: 150px;\n    padding: 16px;\n    border: 3px solid #c62828;\n    border-radius: 18px;\n    background: #ffebee;\n    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);\n    text-align: center;\n    z-index: 9999;\n  }\n\n  .side-score-title {\n    font-size: 17px;\n    font-weight: 800;\n    color: #1f2937;\n    margin-bottom: 8px;\n  }\n\n  .side-score-number {\n    font-size: 30px;\n    font-weight: 900;\n    margin-bottom: 4px;\n  }\n\n  .side-score-target {\n    font-size: 13px;\n    color: #4b5563;\n    margin-bottom: 12px;\n  }\n\n  .side-progress-outer {\n    width: 34px;\n    height: 165px;\n    background: #e5e7eb;\n    border-radius: 999px;\n    overflow: hidden;\n    margin: 0 auto;\n    position: relative;\n    border: 2px solid #d1d5db;\n  }\n\n  .side-progress-inner {\n    position: absolute;\n    bottom: 0;\n    width: 100%;\n    height: 0%;\n    background: #c62828;\n    border-radius: 999px;\n    transition: height 0.3s ease, background 0.3s ease;\n  }\n\n  .side-progress-percent {\n    margin-top: 10px;\n    font-size: 16px;\n    font-weight: 800;\n    color: #374151;\n  }\n\n  #sideValidityMessage {\n    font-size: 13px;\n    line-height: 1.35;\n    margin-top: 12px;\n    color: #c62828;\n    font-weight: 700;\n  }\n\n  @media only screen and (max-width: 1100px) {\n    #side-score-box {\n      right: 20px;\n      width: 145px;\n    }\n\n    .pve-main-layout {\n      padding-right: 165px;\n    }\n  }\n\n  @media only screen and (max-width: 900px) {\n    .pve-main-layout {\n      padding-right: 0;\n    }\n\n    #side-score-box {\n      position: relative;\n      top: auto;\n      right: auto;\n      width: auto;\n      margin-bottom: 22px;\n    }\n\n    .side-progress-outer {\n      height: 100px;\n    }\n  }\n\n  @media only screen and (max-width: 700px) {\n    .pve-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .pve-title {\n      font-size: 30px;\n    }\n\n    .pve-intro {\n      font-size: 18px;\n    }\n  }\n<\/style>\n\n<div id=\"pve-container\">\n\n  <div class=\"pve-title\">Choose your policy package<\/div>\n\n  <div class=\"pve-intro\">\n    ASML wants to reach a total effectiveness score of at least \n    <strong><span id=\"target-score-label\">20<\/span> points<\/strong>.\n    Adjust the policy levels below and try to reach the target.\n  <\/div>\n\n  <div class=\"pve-main-layout\">\n\n    <div class=\"pve-grid\">\n\n      <div class=\"pve-box\">\n        <div class=\"pve-card-header\">\n          <h4>Parking rights policy<\/h4>\n        <\/div>\n        <div class=\"pve-card-body\">\n          <div class=\"pve-description\">\n            This policy means that employees can voluntarily give up their parking rights in exchange for alternative rewards or benefits.\n          <\/div>\n          <select id=\"parkingRights\">\n            <option value=\"0\">Do not introduce policy<\/option>\n            <option value=\"12\">Introduce policy<\/option>\n          <\/select>\n          <div class=\"score-row\">\n            <span>Effectiveness score<\/span>\n            <span class=\"score-badge\" id=\"scoreParkingRights\">0<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"pve-box\">\n        <div class=\"pve-card-header\">\n          <h4>Parking payment policy<\/h4>\n        <\/div>\n        <div class=\"pve-card-body\">\n          <div class=\"pve-description\">\n            This policy means that employees pay a fee when using a parking spot at ASML.\n          <\/div>\n          <select id=\"parkingPayment\">\n            <option value=\"0\">\u20ac0<\/option>\n            <option value=\"2\">\u20ac1<\/option>\n            <option value=\"8\">\u20ac3<\/option>\n            <option value=\"11\">\u20ac4<\/option>\n          <\/select>\n          <div class=\"score-row\">\n            <span>Effectiveness score<\/span>\n            <span class=\"score-badge\" id=\"scoreParkingPayment\">0<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"pve-box\">\n        <div class=\"pve-card-header\">\n          <h4>Parking reservation system<\/h4>\n        <\/div>\n        <div class=\"pve-card-body\">\n          <div class=\"pve-description\">\n            This policy means that parking priority is given to employees who live further away, for example more than 20 km from ASML.\n          <\/div>\n          <select id=\"reservationSystem\">\n            <option value=\"0\">No priority system<\/option>\n            <option value=\"6\">Priority system<\/option>\n          <\/select>\n          <div class=\"score-row\">\n            <span>Effectiveness score<\/span>\n            <span class=\"score-badge\" id=\"scoreReservation\">0<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"pve-box\">\n        <div class=\"pve-card-header\">\n          <h4>P+R reward<\/h4>\n        <\/div>\n        <div class=\"pve-card-body\">\n          <div class=\"pve-description\">\n            This policy means that employees receive a reward when they park at a Park & Ride location and continue their trip to ASML with another mode.\n          <\/div>\n          <select id=\"prReward\">\n            <option value=\"0\">\u20ac0<\/option>\n            <option value=\"2\">\u20ac1<\/option>\n            <option value=\"4\">\u20ac3<\/option>\n          <\/select>\n          <div class=\"score-row\">\n            <span>Effectiveness score<\/span>\n            <span class=\"score-badge\" id=\"scorePRReward\">0<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n\n    <\/div>\n\n    <div id=\"side-score-box\">\n      <div class=\"side-score-title\">Total score<\/div>\n\n      <div class=\"side-score-number\">\n        <span id=\"totalScore\">0<\/span>\n      <\/div>\n\n      <div class=\"side-score-target\">\n        Target: <span id=\"targetScore\">20<\/span> points\n      <\/div>\n\n      <div class=\"side-progress-outer\">\n        <div class=\"side-progress-inner\" id=\"sideProgressBar\"><\/div>\n      <\/div>\n\n      <div class=\"side-progress-percent\">\n        <span id=\"progressPercentLabel\">0<\/span>%\n      <\/div>\n\n      <p id=\"sideValidityMessage\">\n        Target not yet reached.\n      <\/p>\n    <\/div>\n\n  <\/div>\n\n<\/div>","DataExportTag":"Q2","QuestionID":"QID2"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"Distance to ASML Approximately how far do you live from the ASML location where you usually work?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Distance to ASML<\/div>\n\n  <p class=\"ranking-question-text\">\n    Approximately how far do you live from the ASML location where you usually work?\n  <\/p>\n\n\n\n<\/div>\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q20","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Distance to ASML Approximately how far do you live from the ASML location where you usually work?","Choices":{"1":{"Display":"Less than 5 km"},"2":{"Display":"5\u201310 km"},"3":{"Display":"10\u201320 km"},"4":{"Display":"20\u201330 km"},"5":{"Display":"30\u201350 km"},"6":{"Display":"More than 50 km"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID20"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Days at the office In a typical working week, how many days do you usually come to an ASML location?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Days at the office<\/div>\n\n  <p class=\"ranking-question-text\">\n    In a typical working week, how many days do you usually come to an ASML location?\n  <\/p>\n\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q21","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Days at the office In a typical working week, how many days do you usually come to an ASML location?","Choices":{"1":{"Display":"0 days"},"2":{"Display":"1 day"},"3":{"Display":"2 days"},"4":{"Display":"3 days"},"5":{"Display":"4 days"},"6":{"Display":"5 days"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID21"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID22","SecondaryAttribute":"Working from home To what extent does your job allow you to work from home? How to answer this qu...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Working from home<\/div>\n\n  <p class=\"ranking-question-text\">\n    To what extent does your job allow you to work from home?\n  <\/p>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">How to answer this question<\/div>\n\n    <p>\n      Please choose the option that best describes what is possible in your role, even if your actual working-from-home pattern changes from week to week.\n    <\/p>\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q22","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Working from home To what extent does your job allow you to work from home? How to answer this qu...","Choices":{"1":{"Display":"I cannot work from home"},"2":{"Display":"I can work from home occasionally"},"3":{"Display":"I can work from home 1\u20132 days per week"},"4":{"Display":"I can work from home 3 or more days per week"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID22"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID23","SecondaryAttribute":"Current transport use In a typical working week, how many days do you use each of the following t...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Current transport use<\/div>\n\n  <p class=\"ranking-question-text\">\n    In a typical working week, how many days do you use each of the following transport options as your main way of travelling to ASML?\n  <\/p>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">How to answer this question<\/div>\n\n    <p>\n      For each transport option, select how many days per week you usually use it as your main way of travelling to ASML.\n    <\/p>\n\n    <div class=\"ranking-example-box\">\n      Example: If you cycle to ASML three days per week, select \u201c3 days\u201d for bicycle or e-bike.\n    <\/div>\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":{"1":{"1":{"Selected":true}},"2":{"1":{"Selected":true}},"3":{"1":{"Selected":true}},"4":{"1":{"Selected":true}},"5":{"1":{"Selected":true}},"6":{"1":{"Selected":true}},"7":{"1":{"Selected":true}},"8":{"1":{"Selected":true}},"9":{"1":{"Selected":true}}},"DataExportTag":"Q23","QuestionID":"QID23","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Current transport use In a typical working week, how many days do you use each of the following t...","Choices":{"1":{"Display":"Car \/ motorbike + park at ASML campus"},"2":{"Display":"Car \/ motorbike + park at P+R"},"3":{"Display":"Moped \/ Scooter"},"4":{"Display":"Bicycle \/ e-bike"},"5":{"Display":"Vanpool"},"6":{"Display":"Carpool"},"7":{"Display":"Bus"},"8":{"Display":"Train to Eindhoven Centraal + Bus"},"9":{"Display":"Train to Eindhoven Centraal + e-bike"}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":6,"Answers":{"1":{"Display":"0 days"},"2":{"Display":"1 day"},"3":{"Display":"2 days"},"4":{"Display":"3 days"},"5":{"Display":"4 days"},"6":{"Display":"5 days"}}