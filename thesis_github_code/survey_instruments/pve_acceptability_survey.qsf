{"SurveyEntry":{"SurveyID":"SV_9nl3y19r7XQUV1A","SurveyName":"Access & Mobility Survey on Acceptability","SurveyDescription":null,"SurveyOwnerID":"UR_5yymHoZtv4LJF6S","SurveyBrandID":"asmlcx","DivisionID":null,"SurveyLanguage":"EN","SurveyActiveResponseSet":"RS_5ALjcgIIb4p4uDc","SurveyStatus":"Active","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2026-06-01 01:52:20","CreatorID":"UR_5yymHoZtv4LJF6S","LastModified":"2026-08-12 09:17:56","LastAccessed":"0000-00-00 00:00:00","LastActivated":"2026-06-01 02:22:38","Deleted":null},"SurveyElements":[{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":[{"Type":"Default","Description":"Introduction questions PVE","ID":"BL_eb8nnNjDCdTiVHo","BlockElements":[{"Type":"Question","QuestionID":"QID31"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID19"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID32"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID25"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID21"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID22"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID23"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID24"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID26"},{"Type":"Question","QuestionID":"QID27"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID28"},{"Type":"Question","QuestionID":"QID29"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID30"}]},{"Type":"Trash","Description":"Trash \/ Unused Questions","ID":"BL_bO9aURpNNSmQ6s6","BlockElements":[{"Type":"Question","QuestionID":"QID1"},{"Type":"Question","QuestionID":"QID5"},{"Type":"Question","QuestionID":"QID6"},{"Type":"Question","QuestionID":"QID7"},{"Type":"Question","QuestionID":"QID9"},{"Type":"Question","QuestionID":"QID20"}]},{"Type":"Standard","Description":"PWE","ID":"BL_4SCf10wmHGExoq2","BlockElements":[{"Type":"Question","QuestionID":"QID3"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID2"}]},{"Type":"Standard","SubType":"","Description":"Acceptability questions","ID":"BL_e8nvG3Qes65AacC","BlockElements":[{"Type":"Question","QuestionID":"QID12"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID4"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID8"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID10"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID11"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID13"}]},{"Type":"Standard","SubType":"","Description":"Open questions","ID":"BL_3X9DYGTKpaHbEQm","BlockElements":[{"Type":"Question","QuestionID":"QID18"},{"Type":"Question","QuestionID":"QID14"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID15"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID16"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID17"}]}]},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"FL","PrimaryAttribute":"Survey Flow","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Type":"Root","FlowID":"FL_1","Flow":[{"Type":"Block","ID":"BL_eb8nnNjDCdTiVHo","FlowID":"FL_2","Autofill":[]},{"Type":"Standard","ID":"BL_4SCf10wmHGExoq2","FlowID":"FL_4","Autofill":[]},{"Type":"EmbeddedData","FlowID":"FL_7","EmbeddedData":[{"Description":"pve_parking_rights_policy","Type":"Recipient","Field":"pve_parking_rights_policy","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_parking_cost","Type":"Recipient","Field":"pve_parking_cost","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_parking_reservation","Type":"Recipient","Field":"pve_parking_reservation","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_pr_reward","Type":"Recipient","Field":"pve_pr_reward","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_vp_taxi","Type":"Recipient","Field":"pve_vp_taxi","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_vp_frequency","Type":"Recipient","Field":"pve_vp_frequency","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_parking_rights_policy_label","Type":"Recipient","Field":"pve_parking_rights_policy_label","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_parking_cost_label","Type":"Recipient","Field":"pve_parking_cost_label","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_parking_reservation_label","Type":"Recipient","Field":"pve_parking_reservation_label","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_pr_reward_label","Type":"Recipient","Field":"pve_pr_reward_label","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_vp_taxi_label","Type":"Recipient","Field":"pve_vp_taxi_label","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_vp_frequency_label","Type":"Recipient","Field":"pve_vp_frequency_label","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_prob_car","Type":"Recipient","Field":"pve_prob_car","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_prob_pr","Type":"Recipient","Field":"pve_prob_pr","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_prob_vanpool","Type":"Recipient","Field":"pve_prob_vanpool","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_prob_pt","Type":"Recipient","Field":"pve_prob_pt","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_prob_bike","Type":"Recipient","Field":"pve_prob_bike","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_share_car_grouped","Type":"Recipient","Field":"pve_share_car_grouped","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_share_bike_grouped","Type":"Recipient","Field":"pve_share_bike_grouped","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_share_public_transport_grouped","Type":"Recipient","Field":"pve_share_public_transport_grouped","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_share_car_percent","Type":"Recipient","Field":"pve_share_car_percent","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_share_bike_percent","Type":"Recipient","Field":"pve_share_bike_percent","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_share_public_transport_percent","Type":"Recipient","Field":"pve_share_public_transport_percent","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"pve_car_reduction_pp","Type":"Recipient","Field":"pve_car_reduction_pp","VariableType":"String","DataVisibility":[],"AnalyzeText":false}]},{"Type":"Standard","ID":"BL_e8nvG3Qes65AacC","FlowID":"FL_5","Autofill":[]},{"Type":"Standard","ID":"BL_3X9DYGTKpaHbEQm","FlowID":"FL_6","Autofill":[]}],"Properties":{"Count":7}}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"0121c1db-b51f-4cd6-a2a9-10d0d5998089"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"32","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"RS","PrimaryAttribute":"RS_5ALjcgIIb4p4uDc","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"true","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"Previous","NextButton":"Next","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"asmlcx","SkinType":"templated","Skin":{"brandingId":"3873131251","templateId":"*base","overrides":null},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","SurveyName":"Access & Mobility Survey on Acceptability","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"ProtectSelectionIds":true}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Choose your policy package ASML wants to reach a total effectiveness score of at least 20 points....","TertiaryAttribute":null,"Payload":{"QuestionText":"<style>\n  #pve-container {\n    max-width: 1050px;\n    margin: 0 auto;\n    font-family: Arial, sans-serif;\n    color: #1f2937;\n  }\n\n  .pve-title {\n    font-size: 36px;\n    font-weight: 800;\n    color: #003b8f;\n    margin-bottom: 8px;\n  }\n\n  .pve-intro {\n    font-size: 22px;\n    line-height: 1.4;\n    color: #4b5563;\n    margin-bottom: 24px;\n  }\n\n  .pve-main-layout {\n    display: block;\n    padding-right: 120px;\n  }\n\n  .pve-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(260px, 1fr));\n    gap: 22px;\n  }\n\n  .pve-box {\n    border: 2px solid #d7e6ff;\n    border-radius: 18px;\n    background: #ffffff;\n    box-shadow: 0 4px 12px rgba(0, 59, 143, 0.10);\n    overflow: hidden;\n  }\n\n  .pve-card-header {\n    background: linear-gradient(135deg, #003b8f, #0072ce);\n    color: white;\n    padding: 16px 18px;\n  }\n\n  .pve-card-header h4 {\n    margin: 0;\n    font-size: 24px;\n    font-weight: 800;\n    color: white;\n  }\n\n  .pve-card-body {\n    padding: 18px;\n  }\n\n  .pve-description {\n    font-size: 15px;\n    line-height: 1.45;\n    color: #374151;\n    background: #f3f8ff;\n    border-left: 4px solid #0072ce;\n    border-radius: 8px;\n    padding: 12px 14px;\n    min-height: 80px;\n    margin-bottom: 16px;\n  }\n\n  .pve-box select {\n    width: 100%;\n    padding: 10px;\n    border: 1.5px solid #b9d4f8;\n    border-radius: 8px;\n    font-size: 16px;\n    background-color: #f8fbff;\n    margin-bottom: 14px;\n  }\n\n  .score-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    background: #eef6ff;\n    border-radius: 10px;\n    padding: 10px 12px;\n    font-size: 16px;\n  }\n\n  .score-badge {\n    background: #0072ce;\n    color: white;\n    border-radius: 999px;\n    padding: 6px 14px;\n    font-weight: 800;\n    min-width: 34px;\n    text-align: center;\n  }\n\n  #side-score-box {\n    position: fixed;\n    top: 200px;\n    right: 130px;\n    width: 150px;\n    padding: 16px;\n    border: 3px solid #c62828;\n    border-radius: 18px;\n    background: #ffebee;\n    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);\n    text-align: center;\n    z-index: 9999;\n  }\n\n  .side-score-title {\n    font-size: 17px;\n    font-weight: 800;\n    color: #1f2937;\n    margin-bottom: 8px;\n  }\n\n  .side-score-number {\n    font-size: 30px;\n    font-weight: 900;\n    margin-bottom: 4px;\n  }\n\n  .side-score-target {\n    font-size: 13px;\n    color: #4b5563;\n    margin-bottom: 12px;\n  }\n\n  .side-progress-outer {\n    width: 34px;\n    height: 165px;\n    background: #e5e7eb;\n    border-radius: 999px;\n    overflow: hidden;\n    margin: 0 auto;\n    position: relative;\n    border: 2px solid #d1d5db;\n  }\n\n  .side-progress-inner {\n    position: absolute;\n    bottom: 0;\n    width: 100%;\n    height: 0%;\n    background: #c62828;\n    border-radius: 999px;\n    transition: height 0.3s ease, background 0.3s ease;\n  }\n\n  .side-progress-percent {\n    margin-top: 10px;\n    font-size: 16px;\n    font-weight: 800;\n    color: #374151;\n  }\n\n  #sideValidityMessage {\n    font-size: 13px;\n    line-height: 1.35;\n    margin-top: 12px;\n    color: #c62828;\n    font-weight: 700;\n  }\n\n  @media only screen and (max-width: 1100px) {\n    #side-score-box {\n      right: 20px;\n      width: 145px;\n    }\n\n    .pve-main-layout {\n      padding-right: 165px;\n    }\n  }\n\n  @media only screen and (max-width: 900px) {\n    .pve-main-layout {\n      padding-right: 0;\n    }\n\n    #side-score-box {\n      position: relative;\n      top: auto;\n      right: auto;\n      width: auto;\n      margin-bottom: 22px;\n    }\n\n    .side-progress-outer {\n      height: 100px;\n    }\n  }\n\n  @media only screen and (max-width: 700px) {\n    .pve-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .pve-title {\n      font-size: 30px;\n    }\n\n    .pve-intro {\n      font-size: 18px;\n    }\n  }\n<\/style>\n\n<div id=\"pve-container\">\n\n  <div class=\"pve-title\">Choose your policy package<\/div>\n\n  <div class=\"pve-intro\">\n    ASML wants to reach a total effectiveness score of at least \n    <strong><span id=\"target-score-label\">20<\/span> points<\/strong>.\n    Adjust the policy levels below and try to reach the target.\n  <\/div>\n\n  <div class=\"pve-main-layout\">\n\n    <div class=\"pve-grid\">\n\n      <div class=\"pve-box\">\n        <div class=\"pve-card-header\">\n          <h4>Parking rights policy<\/h4>\n        <\/div>\n        <div class=\"pve-card-body\">\n          <div class=\"pve-description\">\n            This policy means that employees can voluntarily give up their parking rights in exchange for alternative rewards or benefits.\n          <\/div>\n          <select id=\"parkingRights\">\n            <option value=\"0\">Do not introduce policy<\/option>\n            <option value=\"12\">Introduce policy<\/option>\n          <\/select>\n          <div class=\"score-row\">\n            <span>Effectiveness score<\/span>\n            <span class=\"score-badge\" id=\"scoreParkingRights\">0<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"pve-box\">\n        <div class=\"pve-card-header\">\n          <h4>Parking payment policy<\/h4>\n        <\/div>\n        <div class=\"pve-card-body\">\n          <div class=\"pve-description\">\n            This policy means that employees pay a fee when using a parking spot at ASML.\n          <\/div>\n          <select id=\"parkingPayment\">\n            <option value=\"0\">\u20ac0<\/option>\n            <option value=\"2\">\u20ac1<\/option>\n            <option value=\"8\">\u20ac3<\/option>\n            <option value=\"11\">\u20ac4<\/option>\n          <\/select>\n          <div class=\"score-row\">\n            <span>Effectiveness score<\/span>\n            <span class=\"score-badge\" id=\"scoreParkingPayment\">0<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"pve-box\">\n        <div class=\"pve-card-header\">\n          <h4>Parking reservation system<\/h4>\n        <\/div>\n        <div class=\"pve-card-body\">\n          <div class=\"pve-description\">\n            This policy means that parking priority is given to employees who live further away, for example more than 20 km from ASML.\n          <\/div>\n          <select id=\"reservationSystem\">\n            <option value=\"0\">No priority system<\/option>\n            <option value=\"6\">Priority system<\/option>\n          <\/select>\n          <div class=\"score-row\">\n            <span>Effectiveness score<\/span>\n            <span class=\"score-badge\" id=\"scoreReservation\">0<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"pve-box\">\n        <div class=\"pve-card-header\">\n          <h4>P+R reward<\/h4>\n        <\/div>\n        <div class=\"pve-card-body\">\n          <div class=\"pve-description\">\n            This policy means that employees receive a reward when they park at a Park & Ride location and continue their trip to ASML with another mode.\n          <\/div>\n          <select id=\"prReward\">\n            <option value=\"0\">\u20ac0<\/option>\n            <option value=\"2\">\u20ac1<\/option>\n            <option value=\"4\">\u20ac3<\/option>\n          <\/select>\n          <div class=\"score-row\">\n            <span>Effectiveness score<\/span>\n            <span class=\"score-badge\" id=\"scorePRReward\">0<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n\n    <\/div>\n\n    <div id=\"side-score-box\">\n      <div class=\"side-score-title\">Total score<\/div>\n\n      <div class=\"side-score-number\">\n        <span id=\"totalScore\">0<\/span>\n      <\/div>\n\n      <div class=\"side-score-target\">\n        Target: <span id=\"targetScore\">20<\/span> points\n      <\/div>\n\n      <div class=\"side-progress-outer\">\n        <div class=\"side-progress-inner\" id=\"sideProgressBar\"><\/div>\n      <\/div>\n\n      <div class=\"side-progress-percent\">\n        <span id=\"progressPercentLabel\">0<\/span>%\n      <\/div>\n\n      <p id=\"sideValidityMessage\">\n        Target not yet reached.\n      <\/p>\n    <\/div>\n\n  <\/div>\n\n<\/div>","DefaultChoices":false,"DataExportTag":"Q1","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Choose your policy package ASML wants to reach a total effectiveness score of at least 20 points....","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n\n  var target = 20;\n\n  var nextButton = document.getElementById(\"NextButton\");\n  if (nextButton) {\n    nextButton.disabled = true;\n    nextButton.style.opacity = \"0.5\";\n  }\n\n  var fields = {\n    parkingRights: document.getElementById(\"parkingRights\"),\n    parkingPayment: document.getElementById(\"parkingPayment\"),\n    reservationSystem: document.getElementById(\"reservationSystem\"),\n    prReward: document.getElementById(\"prReward\")\n  };\n\n  function getSelectedText(selectElement) {\n    return selectElement.options[selectElement.selectedIndex].text;\n  }\n\n  function saveEmbeddedData(name, value) {\n    if (Qualtrics.SurveyEngine.setEmbeddedData) {\n      Qualtrics.SurveyEngine.setEmbeddedData(name, value);\n    }\n  }\n\n  function updateScores() {\n    var parkingRightsScore = Number(fields.parkingRights.value);\n    var parkingPaymentScore = Number(fields.parkingPayment.value);\n    var reservationScore = Number(fields.reservationSystem.value);\n    var prRewardScore = Number(fields.prReward.value);\n\n    var total = parkingRightsScore + parkingPaymentScore + reservationScore + prRewardScore;\n    var valid = total >= target;\n\n    document.getElementById(\"scoreParkingRights\").innerText = parkingRightsScore;\n    document.getElementById(\"scoreParkingPayment\").innerText = parkingPaymentScore;\n    document.getElementById(\"scoreReservation\").innerText = reservationScore;\n    document.getElementById(\"scorePRReward\").innerText = prRewardScore;\n    document.getElementById(\"totalScore\").innerText = total;\n\n    var progressPercent = Math.min((total \/ target) * 100, 100);\n\n    var sideProgressBar = document.getElementById(\"sideProgressBar\");\n    sideProgressBar.style.height = progressPercent + \"%\";\n\n    document.getElementById(\"progressPercentLabel\").innerText = Math.round(progressPercent);\n\n    var sideScoreBox = document.getElementById(\"side-score-box\");\n    var message = document.getElementById(\"sideValidityMessage\");\n\n    if (valid) {\n      sideScoreBox.style.borderColor = \"#007a3d\";\n      sideScoreBox.style.backgroundColor = \"#e8f7ef\";\n      sideProgressBar.style.background = \"#007a3d\";\n      message.innerText = \"Valid package: target reached.\";\n      message.style.color = \"#007a3d\";\n\n      if (nextButton) {\n        nextButton.disabled = false;\n        nextButton.style.opacity = \"1\";\n      }\n    } else {\n      sideScoreBox.style.borderColor = \"#c62828\";\n      sideScoreBox.style.backgroundColor = \"#ffebee\";\n      sideProgressBar.style.background = \"#c62828\";\n      message.innerText = \"Target not yet reached.\";\n      message.style.color = \"#c62828\";\n\n      if (nextButton) {\n        nextButton.disabled = true;\n        nextButton.style.opacity = \"0.5\";\n      }\n    }\n\n    saveEmbeddedData(\"pve_parking_rights_level\", getSelectedText(fields.parkingRights));\n    saveEmbeddedData(\"pve_parking_payment_level\", getSelectedText(fields.parkingPayment));\n    saveEmbeddedData(\"pve_reservation_level\", getSelectedText(fields.reservationSystem));\n    saveEmbeddedData(\"pve_pr_reward_level\", getSelectedText(fields.prReward));\n\n    saveEmbeddedData(\"pve_parking_rights_score\", parkingRightsScore);\n    saveEmbeddedData(\"pve_parking_payment_score\", parkingPaymentScore);\n    saveEmbeddedData(\"pve_reservation_score\", reservationScore);\n    saveEmbeddedData(\"pve_pr_reward_score\", prRewardScore);\n    saveEmbeddedData(\"pve_total_score\", total);\n    saveEmbeddedData(\"pve_valid\", valid ? \"1\" : \"0\");\n  }\n\n  Object.keys(fields).forEach(function (key) {\n    fields[key].addEventListener(\"change\", updateScores);\n  });\n\n  updateScores();\n});"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Convenience Please rank the mobility policies based on how convenient you think they would be for...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-question-title\">Convenience<\/div>\n\n<p class=\"ranking-question-text\">\n  Please rank the mobility policies based on how convenient you think they would be for employees in their daily commute.\n  A convenient policy requires little extra time, effort, planning, or loss of flexibility.\n<\/p>\n\n<div class=\"ranking-instruction-box\">\n  <div class=\"ranking-instruction-title\">How to answer this question<\/div>\n\n  <ol>\n    <li>Look at the list of mobility policies below.<\/li>\n    <li>Click and hold a policy.<\/li>\n    <li>Drag it up or down to change the order.<\/li>\n    <li>Put the policy you think is <strong>most convenient<\/strong> at the top.<\/li>\n    <li>Put the policy you think is <strong>least convenient<\/strong> at the bottom.<\/li>\n  <\/ol>\n\n  <div class=\"ranking-example-box\">\n    <div><strong>Top<\/strong> = most convenient policy<\/div>\n    <div><strong>Bottom<\/strong> = least convenient policy<\/div>\n  <\/div>\n<\/div>\n\n  <div class=\"policy-help-wrapper\">\n\n    <div class=\"policy-help-reminder\">\n      Not sure what each policy means?\n    <\/div>\n\n    <button type=\"button\" class=\"policy-help-toggle\" aria-expanded=\"false\">\n      Click here to show policy descriptions again\n    <\/button>\n\n    <div class=\"policy-help-panel\" style=\"display: none;\">\n\n      <div class=\"policy-help-title\">Policy descriptions<\/div>\n\n      <div class=\"policy-help-grid\">\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking rights policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees can voluntarily give up their parking rights at ASML in exchange for one of several alternative benefits.\n              These benefits are meant to make it more attractive for employees to stop commuting by car.\n            <\/p>\n\n            <div class=\"policy-help-list-box\">\n              Employees who give up their parking rights can choose one of the following rewards:\n              <ul>\n                <li>Free e-bike<\/li>\n                <li>Unlimited public transport<\/li>\n                <li>Free EV charging point installed at home<\/li>\n                <li>\u20ac2,000 cash reward<\/li>\n              <\/ul>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking payment policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees pay a fee when they use a parking spot at ASML.\n              In the experiment, this fee can be \u20ac0, \u20ac1.50, or \u20ac3 per parking day.\n              A higher parking fee may reduce car use because commuting by car becomes less attractive.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking reservation system<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Parking priority is given to employees who live further away from ASML.\n              Employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters.\n              These employees receive priority when reserving a parking spot.\n              Employees who live closer than 20 kilometres may be encouraged to use another mode of transport, such as cycling or public transport.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>P+R reward<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees receive a financial reward when they use Park & Ride.\n              In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike.\n              This reduces the number of cars travelling directly to campus, while still offering employees a flexible way to complete their commute.\n              In the experiment, the reward can be \u20ac0, \u20ac1.50, or \u20ac3.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Emergency taxi guarantee<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees who use a vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.\n              This policy reduces the risk of being dependent on the vanpool schedule in urgent situations.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Vanpool departures<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              This policy changes how often vanpools depart.\n              In the experiment, vanpools can depart 1, 2, or 4 times per hour.\n              More frequent departures make vanpooling more flexible and may make it more attractive compared to commuting by car.\n            <\/p>\n          <\/div>\n        <\/div>\n\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 18px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box ol {\n  margin: 0 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-instruction-box li {\n  margin: 6px 0;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n.policy-help-wrapper {\n  margin: 20px 0 26px 0;\n}\n\n.policy-help-reminder {\n  font-size: 17px;\n  font-weight: 700;\n  color: #374151;\n  margin-bottom: 10px;\n}\n\n.policy-help-toggle {\n  background: linear-gradient(135deg, #003b8f, #0072ce) !important;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n  border: none !important;\n  border-radius: 10px;\n  padding: 12px 18px;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.18);\n}\n\n.policy-help-toggle:hover {\n  opacity: 0.92;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n}\n\n.policy-help-panel {\n  margin-top: 18px;\n  padding: 20px;\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: #f8fbff;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.policy-help-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 16px;\n}\n\n.policy-help-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 18px;\n}\n\n.policy-help-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 16px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n  overflow: hidden;\n}\n\n.policy-help-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 14px 16px;\n}\n\n.policy-help-header h4 {\n  margin: 0;\n  font-size: 19px;\n  font-weight: 800;\n  color: white;\n}\n\n.policy-help-body {\n  padding: 16px;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.policy-help-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.policy-help-list-box li {\n  margin: 5px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .policy-help-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n  var questionContainer = this.getQuestionContainer();\n\n  var toggleButton = questionContainer.querySelector(\".policy-help-toggle\");\n  var policyPanel = questionContainer.querySelector(\".policy-help-panel\");\n\n  if (!toggleButton || !policyPanel) {\n    return;\n  }\n\n  toggleButton.addEventListener(\"click\", function () {\n    var isHidden = policyPanel.style.display === \"none\" || policyPanel.style.display === \"\";\n\n    if (isHidden) {\n      policyPanel.style.display = \"block\";\n      toggleButton.innerText = \"Hide policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"true\");\n    } else {\n      policyPanel.style.display = \"none\";\n      toggleButton.innerText = \"Show policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"false\");\n    }\n  });\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q10","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Convenience Please rank the mobility policies based on how convenient you think they would be for...","Choices":{"1":{"Display":"Parking rights policy"},"2":{"Display":"Parking payment policy"},"3":{"Display":"Parking reservation system"},"4":{"Display":"P+R reward"},"5":{"Display":"Emergency taxi guarantee"},"6":{"Display":"Vanpool departures"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID10"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Personal support Please rank the mobility policies based on how much you personally support ASML...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-question-title\">Personal support<\/div>\n\n<p class=\"ranking-question-text\">\n  Please rank the mobility policies based on how much you personally support ASML implementing them.\n  This is about your overall opinion of each policy, considering both its advantages and disadvantages.\n<\/p>\n\n<div class=\"ranking-instruction-box\">\n  <div class=\"ranking-instruction-title\">How to answer this question<\/div>\n\n  <ol>\n    <li>Look at the list of mobility policies below.<\/li>\n    <li>Click and hold a policy.<\/li>\n    <li>Drag it up or down to change the order.<\/li>\n    <li>Put the policy you <strong>support most<\/strong> at the top.<\/li>\n    <li>Put the policy you <strong>support least<\/strong> at the bottom.<\/li>\n  <\/ol>\n\n  <div class=\"ranking-example-box\">\n    <div><strong>Top<\/strong> = policy you support most<\/div>\n    <div><strong>Bottom<\/strong> = policy you support least<\/div>\n  <\/div>\n<\/div>\n\n  <div class=\"policy-help-wrapper\">\n\n    <div class=\"policy-help-reminder\">\n      Not sure what each policy means?\n    <\/div>\n\n    <button type=\"button\" class=\"policy-help-toggle\" aria-expanded=\"false\">\n      Click here to show policy descriptions again\n    <\/button>\n\n    <div class=\"policy-help-panel\" style=\"display: none;\">\n\n      <div class=\"policy-help-title\">Policy descriptions<\/div>\n\n      <div class=\"policy-help-grid\">\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking rights policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees can voluntarily give up their parking rights at ASML in exchange for one of several alternative benefits.\n              These benefits are meant to make it more attractive for employees to stop commuting by car.\n            <\/p>\n\n            <div class=\"policy-help-list-box\">\n              Employees who give up their parking rights can choose one of the following rewards:\n              <ul>\n                <li>Free e-bike<\/li>\n                <li>Unlimited public transport<\/li>\n                <li>Free EV charging point installed at home<\/li>\n                <li>\u20ac2,000 cash reward<\/li>\n              <\/ul>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking payment policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees pay a fee when they use a parking spot at ASML.\n              In the experiment, this fee can be \u20ac0, \u20ac1.50, or \u20ac3 per parking day.\n              A higher parking fee may reduce car use because commuting by car becomes less attractive.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking reservation system<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Parking priority is given to employees who live further away from ASML.\n              Employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters.\n              These employees receive priority when reserving a parking spot.\n              Employees who live closer than 20 kilometres may be encouraged to use another mode of transport, such as cycling or public transport.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>P+R reward<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees receive a financial reward when they use Park & Ride.\n              In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike.\n              This reduces the number of cars travelling directly to campus, while still offering employees a flexible way to complete their commute.\n              In the experiment, the reward can be \u20ac0, \u20ac1.50, or \u20ac3.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Emergency taxi guarantee<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees who use a vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.\n              This policy reduces the risk of being dependent on the vanpool schedule in urgent situations.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Vanpool departures<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              This policy changes how often vanpools depart.\n              In the experiment, vanpools can depart 1, 2, or 4 times per hour.\n              More frequent departures make vanpooling more flexible and may make it more attractive compared to commuting by car.\n            <\/p>\n          <\/div>\n        <\/div>\n\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 18px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box ol {\n  margin: 0 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-instruction-box li {\n  margin: 6px 0;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n.policy-help-wrapper {\n  margin: 20px 0 26px 0;\n}\n\n.policy-help-reminder {\n  font-size: 17px;\n  font-weight: 700;\n  color: #374151;\n  margin-bottom: 10px;\n}\n\n.policy-help-toggle {\n  background: linear-gradient(135deg, #003b8f, #0072ce) !important;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n  border: none !important;\n  border-radius: 10px;\n  padding: 12px 18px;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.18);\n}\n\n.policy-help-toggle:hover {\n  opacity: 0.92;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n}\n\n.policy-help-panel {\n  margin-top: 18px;\n  padding: 20px;\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: #f8fbff;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.policy-help-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 16px;\n}\n\n.policy-help-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 18px;\n}\n\n.policy-help-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 16px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n  overflow: hidden;\n}\n\n.policy-help-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 14px 16px;\n}\n\n.policy-help-header h4 {\n  margin: 0;\n  font-size: 19px;\n  font-weight: 800;\n  color: white;\n}\n\n.policy-help-body {\n  padding: 16px;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.policy-help-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.policy-help-list-box li {\n  margin: 5px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .policy-help-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n  var questionContainer = this.getQuestionContainer();\n\n  var toggleButton = questionContainer.querySelector(\".policy-help-toggle\");\n  var policyPanel = questionContainer.querySelector(\".policy-help-panel\");\n\n  if (!toggleButton || !policyPanel) {\n    return;\n  }\n\n  toggleButton.addEventListener(\"click\", function () {\n    var isHidden = policyPanel.style.display === \"none\" || policyPanel.style.display === \"\";\n\n    if (isHidden) {\n      policyPanel.style.display = \"block\";\n      toggleButton.innerText = \"Hide policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"true\");\n    } else {\n      policyPanel.style.display = \"none\";\n      toggleButton.innerText = \"Show policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"false\");\n    }\n  });\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q11","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Personal support Please rank the mobility policies based on how much you personally support ASML...","Choices":{"1":{"Display":"Parking rights policy"},"2":{"Display":"Parking payment policy"},"3":{"Display":"Parking reservation system"},"4":{"Display":"P+R reward"},"5":{"Display":"Emergency taxi guarantee"},"6":{"Display":"Vanpool departures"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID11"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Ranking the mobility policies You have just chosen a policy package to help ASML reduce car use....","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-intro-container\">\n\n  <div class=\"ranking-intro-title\">Ranking the mobility policies<\/div>\n\n  <p class=\"ranking-intro-text\">\n    You have just chosen a policy package to help ASML reduce car use.\n    In the next part, we would like to understand how you view the individual mobility policies.\n  <\/p>\n\n  <div class=\"ranking-intro-highlight\">\n    You will be asked to rank the same policies several times.\n    Each question focuses on a different aspect of the policies.\n    There are no right or wrong answers \u2014 we are interested in your opinion.\n  <\/div>\n\n  <div class=\"ranking-intro-section-title\">What will you rank?<\/div>\n\n  <div class=\"ranking-intro-grid\">\n\n    <div class=\"ranking-intro-box\">\n      <div class=\"ranking-intro-card-header\">\n        <h4>Effectiveness<\/h4>\n      <\/div>\n      <div class=\"ranking-intro-card-body\">\n        <p>\n          Which policies do you think would be most effective in reducing car use among ASML employees?\n        <\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"ranking-intro-box\">\n      <div class=\"ranking-intro-card-header\">\n        <h4>Fairness<\/h4>\n      <\/div>\n      <div class=\"ranking-intro-card-body\">\n        <p>\n          Which policies do you think are fairest for ASML employees?\n        <\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"ranking-intro-box\">\n      <div class=\"ranking-intro-card-header\">\n        <h4>Convenience<\/h4>\n      <\/div>\n      <div class=\"ranking-intro-card-body\">\n        <p>\n          Which policies do you think would be most convenient for employees in their daily commute?\n        <\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"ranking-intro-box\">\n      <div class=\"ranking-intro-card-header\">\n        <h4>Personal support<\/h4>\n      <\/div>\n      <div class=\"ranking-intro-card-body\">\n        <p>\n          Which policies do you personally support most?\n        <\/p>\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n  <div class=\"ranking-intro-instruction-box\">\n    <div class=\"ranking-intro-instruction-title\">How the ranking questions work<\/div>\n\n    <ol>\n      <li>You will see a list of mobility policies.<\/li>\n      <li>Click and hold a policy.<\/li>\n      <li>Drag it up or down to change the order.<\/li>\n      <li>Put the policy that best matches the question at the top.<\/li>\n      <li>Put the policy that least matches the question at the bottom.<\/li>\n    <\/ol>\n\n    <div class=\"ranking-intro-example-box\">\n      <div><strong>Top<\/strong> = highest ranked policy<\/div>\n      <div><strong>Bottom<\/strong> = lowest ranked policy<\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"ranking-intro-final-box\">\n    On each ranking page, you can also click a button to show the policy descriptions again.\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-intro-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-intro-title {\n  font-size: 36px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-intro-text {\n  font-size: 21px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 18px;\n}\n\n.ranking-intro-highlight {\n  font-size: 17px;\n  line-height: 1.5;\n  color: #374151;\n  background: #f3f8ff;\n  border-left: 5px solid #0072ce;\n  border-radius: 10px;\n  padding: 16px 18px;\n  margin-bottom: 28px;\n}\n\n.ranking-intro-section-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: #003b8f;\n  margin: 28px 0 16px 0;\n}\n\n.ranking-intro-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 22px;\n  margin-bottom: 26px;\n}\n\n.ranking-intro-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.10);\n  overflow: hidden;\n}\n\n.ranking-intro-card-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 15px 18px;\n}\n\n.ranking-intro-card-header h4 {\n  margin: 0;\n  font-size: 21px;\n  font-weight: 800;\n  color: white;\n}\n\n.ranking-intro-card-body {\n  padding: 17px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.ranking-intro-card-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.ranking-intro-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-intro-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-intro-instruction-box ol {\n  margin: 0 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-intro-instruction-box li {\n  margin: 6px 0;\n}\n\n.ranking-intro-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n.ranking-intro-final-box {\n  margin-top: 24px;\n  padding: 16px 18px;\n  border-radius: 14px;\n  background: #f0fdf4;\n  border: 2px solid #22c55e;\n  color: #166534;\n  font-size: 18px;\n  line-height: 1.45;\n  font-weight: 600;\n}\n\n@media only screen and (max-width: 800px) {\n  .ranking-intro-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .ranking-intro-title {\n    font-size: 32px;\n  }\n\n  .ranking-intro-text {\n    font-size: 19px;\n  }\n}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q12","QuestionID":"QID12","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Ranking the mobility policies You have just chosen a policy package to help ASML reduce car use....","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"Effect on working from home Some mobility policies may not only affect how you travel to ASML, bu...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"ranking-page-container\">\n\n  <div class=\"ranking-question-title\">Effect on working from home<\/div>\n\n  <p class=\"ranking-question-text\">\n    Some mobility policies may not only affect how you travel to ASML, but also whether you decide to come to campus at all.\n  <\/p>\n\n  <p class=\"ranking-question-text\">\n    For each mobility policy below, please indicate how it would affect your own tendency to work from home instead of coming to the ASML campus.\n  <\/p>\n\n  <div class=\"ranking-instruction-box\">\n    <div class=\"ranking-instruction-title\">How to answer this question<\/div>\n\n    <ol>\n      <li>Look at each mobility policy one by one.<\/li>\n      <li>Think about your own commute and work situation.<\/li>\n      <li>Choose the answer that best describes how the policy would affect you.<\/li>\n      <li>If working from home is not possible for your job, choose <strong>Not applicable<\/strong>.<\/li>\n    <\/ol>\n\n    <div class=\"ranking-example-box\">\n      Example: If a parking fee would make you avoid travelling to campus and work from home more often, choose \n      <strong>More likely to work from home<\/strong>.\n    <\/div>\n  <\/div>\n\n  <div class=\"policy-help-wrapper\">\n\n    <div class=\"policy-help-reminder\">\n      Not sure what each policy means?\n    <\/div>\n\n    <button type=\"button\" class=\"policy-help-toggle\" aria-expanded=\"false\">\n      Click here to show policy descriptions again\n    <\/button>\n\n    <div class=\"policy-help-panel\" style=\"display: none;\">\n\n      <div class=\"policy-help-title\">Policy descriptions<\/div>\n\n      <div class=\"policy-help-grid\">\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking rights policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees can voluntarily give up their parking rights at ASML in exchange for one of several alternative benefits.\n              These benefits are meant to make it more attractive for employees to stop commuting by car.\n            <\/p>\n\n            <div class=\"policy-help-list-box\">\n              Employees who give up their parking rights can choose one of the following rewards:\n              <ul>\n                <li>Free e-bike<\/li>\n                <li>Unlimited public transport<\/li>\n                <li>Free EV charging point installed at home<\/li>\n                <li>\u20ac2,000 cash reward<\/li>\n              <\/ul>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking payment policy<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees pay a fee when they use a parking spot at ASML.\n              In the experiment, this fee can be \u20ac0, \u20ac1.50, or \u20ac3 per parking day.\n              A higher parking fee may reduce car use because commuting by car becomes less attractive.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Parking reservation system<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Parking priority is given to employees who live further away from ASML.\n              Employees who live at least <strong>20 kilometres<\/strong> from campus are considered long-distance commuters.\n              These employees receive priority when reserving a parking spot.\n              Employees who live closer than 20 kilometres may be encouraged to use another mode of transport, such as cycling or public transport.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>P+R reward<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees receive a financial reward when they use Park & Ride.\n              In this policy, employees can park at <strong>P+R Koningshof<\/strong> and then continue their trip to the ASML campus by shuttle bus or e-bike.\n              This reduces the number of cars travelling directly to campus, while still offering employees a flexible way to complete their commute.\n              In the experiment, the reward can be \u20ac0, \u20ac1.50, or \u20ac3.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Emergency taxi guarantee<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              Employees who use a vanpool are guaranteed an emergency taxi if they unexpectedly need to leave ASML.\n              This policy reduces the risk of being dependent on the vanpool schedule in urgent situations.\n            <\/p>\n          <\/div>\n        <\/div>\n\n        <div class=\"policy-help-box\">\n          <div class=\"policy-help-header\">\n            <h4>Vanpool departures<\/h4>\n          <\/div>\n          <div class=\"policy-help-body\">\n            <p>\n              This policy changes how often vanpools depart.\n              In the experiment, vanpools can depart 1, 2, or 4 times per hour.\n              More frequent departures make vanpooling more flexible and may make it more attractive compared to commuting by car.\n            <\/p>\n          <\/div>\n        <\/div>\n\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n<\/div>\n\n<style>\n.ranking-page-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.ranking-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.ranking-instruction-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.ranking-instruction-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.ranking-instruction-box ol {\n  margin: 0 0 0 22px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.ranking-instruction-box li {\n  margin: 6px 0;\n}\n\n.ranking-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n.policy-help-wrapper {\n  margin: 20px 0 26px 0;\n  font-family: Arial, sans-serif;\n}\n\n.policy-help-reminder {\n  font-size: 17px;\n  font-weight: 700;\n  color: #374151;\n  margin-bottom: 10px;\n}\n\n.policy-help-toggle {\n  background: linear-gradient(135deg, #003b8f, #0072ce) !important;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n  border: none !important;\n  border-radius: 10px;\n  padding: 12px 18px;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.18);\n}\n\n.policy-help-toggle:hover {\n  opacity: 0.92;\n  color: white !important;\n  -webkit-text-fill-color: white !important;\n}\n\n.policy-help-panel {\n  margin-top: 18px;\n  padding: 20px;\n  border: 2px solid #d7e6ff;\n  border-radius: 18px;\n  background: #f8fbff;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.policy-help-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 16px;\n}\n\n.policy-help-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\n  gap: 18px;\n}\n\n.policy-help-box {\n  border: 2px solid #d7e6ff;\n  border-radius: 16px;\n  background: white;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n  overflow: hidden;\n}\n\n.policy-help-header {\n  background: linear-gradient(135deg, #003b8f, #0072ce);\n  color: white;\n  padding: 14px 16px;\n}\n\n.policy-help-header h4 {\n  margin: 0;\n  font-size: 19px;\n  font-weight: 800;\n  color: white;\n}\n\n.policy-help-body {\n  padding: 16px;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-body p {\n  margin: 0;\n  background: #f3f8ff;\n  border-left: 4px solid #0072ce;\n  border-radius: 8px;\n  padding: 12px 14px;\n}\n\n.policy-help-list-box {\n  margin-top: 14px;\n  padding: 13px 15px;\n  border-radius: 10px;\n  background: #f8fbff;\n  border: 1.5px solid #b9d4f8;\n  font-size: 15px;\n  line-height: 1.45;\n  color: #374151;\n}\n\n.policy-help-list-box ul {\n  margin: 8px 0 0 20px;\n  padding: 0;\n}\n\n.policy-help-list-box li {\n  margin: 5px 0;\n}\n\n@media only screen and (max-width: 800px) {\n  .policy-help-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .ranking-question-title {\n    font-size: 30px;\n  }\n\n  .ranking-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>","DefaultChoices":{"1":{"3":{"Selected":true}},"2":{"3":{"Selected":true}},"3":{"3":{"Selected":true}},"4":{"3":{"Selected":true}},"5":{"3":{"Selected":true}},"6":{"3":{"Selected":true}}},"DataExportTag":"Q13","QuestionID":"QID13","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true,"Autoscale":{"XScale":{"Name":"hedonic","Type":"likert","Reverse":false}}},"QuestionDescription":"Effect on working from home Some mobility policies may not only affect how you travel to ASML, bu...","Choices":{"1":{"Display":"Parking rights policy"},"2":{"Display":"Parking payment policy"},"3":{"Display":"Parking reservation system"},"4":{"Display":"P+R reward"},"5":{"Display":"Emergency taxi guarantee"},"6":{"Display":"Vanpool departures"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":7,"Answers":{"1":{"Display":"Much less likely to work from home"},"2":{"Display":"Slightly less likely to work from home"},"3":{"Display":"No effect"},"4":{"Display":"Slightly more likely to work from home"},"5":{"Display":"Much more likely to work from home"},"6":{"Display":"Not applicable \u2014 I cannot work from home"}},"AnswerOrder":[1,2,3,4,5,6],"ChoiceDataExportTags":false,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n  var questionContainer = this.getQuestionContainer();\n\n  var toggleButton = questionContainer.querySelector(\".policy-help-toggle\");\n  var policyPanel = questionContainer.querySelector(\".policy-help-panel\");\n\n  if (!toggleButton || !policyPanel) {\n    return;\n  }\n\n  toggleButton.addEventListener(\"click\", function () {\n    var isHidden = policyPanel.style.display === \"none\" || policyPanel.style.display === \"\";\n\n    if (isHidden) {\n      policyPanel.style.display = \"block\";\n      toggleButton.innerText = \"Hide policy descriptions\";\n      toggleButton.setAttribute(\"aria-expanded\", \"true\");\n    } else {\n      policyPanel.style.display = \"none\";\n      toggleButton.innerText = \"Click here to show policy descriptions again\";\n      toggleButton.setAttribute(\"aria-expanded\", \"false\");\n    }\n  });\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Your commute experience (optional) What is the most stressful or inconvenient part of your commut...","TertiaryAttribute":null,"Payload":{"QuestionText":"<style>\n.open-question-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.open-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.open-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.open-question-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.open-question-box-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.open-question-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.open-question-example-box {\n  margin-top: 15px;\n  padding: 13px 15px;\n  background: white;\n  border: 1.5px solid #b9d4f8;\n  border-radius: 10px;\n  font-size: 16px;\n  line-height: 1.45;\n  color: #003b8f;\n}\n\n\/* Optional: styles the Qualtrics text entry box *\/\n.Skin .QuestionBody textarea,\n.Skin .QuestionBody input[type=\"text\"] {\n  width: 100% !important;\n  min-height: 120px !important;\n  border: 2px solid #d7e6ff !important;\n  border-radius: 14px !important;\n  background: #f8fbff !important;\n  padding: 14px !important;\n  font-size: 16px !important;\n  font-family: Arial, sans-serif !important;\n  color: #374151 !important;\n  box-shadow: 0 3px 10px rgba(0, 59, 143, 0.08) !important;\n}\n\n.Skin .QuestionBody textarea:focus,\n.Skin .QuestionBody input[type=\"text\"]:focus {\n  outline: none !important;\n  border-color: #0072ce !important;\n  background: white !important;\n}\n\n@media only screen and (max-width: 800px) {\n  .open-question-title {\n    font-size: 30px;\n  }\n\n  .open-question-text {\n    font-size: 18px;\n  }\n}\n<\/style>\n\n<div class=\"open-question-container\">\n\n  <div class=\"open-question-title\">Your commute experience (optional)<\/div>\n\n  <p class=\"open-question-text\">\n    What is the most stressful or inconvenient part of your commute to ASML?\n  <\/p>\n\n  <div class=\"open-question-box\">\n    <div class=\"open-question-box-title\">Please describe your experience<\/div>\n\n    <p>\n      Try to explain what happens, when it happens, and why it is stressful or inconvenient for you.\n    <\/p>\n\n    <div class=\"open-question-example-box\">\n      Examples: traffic congestion, finding a parking spot, or public transport delayscampus.\n    <\/div>\n  <\/div>\n\n<\/div>","DefaultChoices":false,"DataExportTag":"Q14","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Your commute experience (optional) What is the most stressful or inconvenient part of your commut...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID14"}},{"SurveyID":"SV_9nl3y19r7XQUV1A","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Possible improvements (optional) What could ASML do to make your commute easier or less stressful...","TertiaryAttribute":null,"Payload":{"QuestionText":"<style>\n.open-question-container {\n  max-width: 1050px;\n  margin: 0 auto;\n  font-family: Arial, sans-serif;\n  color: #1f2937;\n}\n\n.open-question-title {\n  font-size: 34px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.open-question-text {\n  font-size: 20px;\n  line-height: 1.45;\n  color: #374151;\n  margin-bottom: 14px;\n}\n\n.open-question-box {\n  background: #f3f8ff;\n  border: 2px solid #d7e6ff;\n  border-left: 6px solid #0072ce;\n  border-radius: 16px;\n  padding: 18px 20px;\n  margin: 18px 0 22px 0;\n  box-shadow: 0 4px 12px rgba(0, 59, 143, 0.08);\n}\n\n.open-question-box-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #003b8f;\n  margin-bottom: 10px;\n}\n\n.open-question-box p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.5;\n  color: #374151;\n}\n\n.open-question-example-box {\n