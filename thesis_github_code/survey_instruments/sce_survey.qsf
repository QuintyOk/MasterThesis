19841413","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"Now imagine ASML introduces a <strong>voluntary program<\/strong> where you can <strong>choose to give up your right to park<\/strong> on the ASML campus <strong>for 3 years<\/strong> <em>(you would still be allowed to park at the P+R locations!).<\/em>&nbsp;In exchange, you can request <b>one <\/b>of the following rewards:<br><br>\n1. A free <b>e\u2011bike<\/b> worth \u20ac2,000\n<div style=\"margin-left: 40px;\"><\/div>\n2. A free home <b>EV charging station\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n3. <b>Unlimited <\/b>public transport (including private trips)<div style=\"margin-left: 40px;\"><\/div>\n4. \u20ac2,000 <b>cash <\/b>(gross<b>)\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n\n<div><br>\nBased on the<u> <b>same scenario in the table above<\/b><\/u>, would you be willing to give up your parking rights for 3 years (<em>not including right to park at P+R locations<\/em>)?<\/div>","DataExportTag":"Q32","QuestionID":"QID1219841414"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219841415","SecondaryAttribute":"Having given up your parking right in the above scenario, which transport mode would you choose t...","TertiaryAttribute":null,"Payload":{"QuestionText":"Having given up your parking right in the above scenario, which transport mode would you choose to commute to ASML?","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Having given up your parking right in the above scenario, which transport mode would you choose t...","Choices":{"1":{"Display":"P+R"},"2":{"Display":"Public Transport"}},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1219841414\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Now imagine ASML makes the following voluntary offer.\n\nIf you accept this offer, you give up your right to park on the ASML campus for 3 years.\n\nYou will still be allowed to park at all Park and Ri...<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219841414\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219841414","QuestionIDFromLocator":"QID1219841414","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"Having given up your parking right in the above scenario, which transport mode would you choose to commute to ASML?","DataExportTag":"Q33","QuestionID":"QID1219841415"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219841416","SecondaryAttribute":"You will be presented with 8\u00a0hypothetical situations\/tables. Your responses help us gain better i..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>You will be presented with<b style=\"font-size: 13px;\"> <\/b><b>8&nbsp;hypothetical situations\/tables.<\/b> Your responses help us gain better insight into which factors are most important to you during your commute, as well as the trade-offs you make between different transport options.&nbsp;Changes from the previous table are highlighted <span style=\"color:#2980b9;\">in blue<\/span> for easy comparison.<\/p>\n<br \/>\n<span style=\"font-size:13px;\"><em>Note:&nbsp;<\/em><\/span> <span style=\"font-size:13px;\"> <em>The number shown at the start of each question does <strong>not<\/strong> indicate the order of the questions or how many questions you will see. It simply refers to the randomly assigned scenario you are presented with.<\/em><\/span>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will be presented with 8\u00a0hypothetical situations\/tables. Your responses help us gain better i...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Block 6C","DataExportTag":"Q1","QuestionID":"QID1219841416"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219841417","SecondaryAttribute":"(3) Assuming conditions on busiest weekdays, please indicate which travel option you would likely...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>(3)<\/strong> Assuming conditions on busiest weekdays, please indicate which travel option you would likely choose most regularly:<\/p>\n\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t