pan class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID626\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID626","QuestionIDFromLocator":"QID626","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true}}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID628","SecondaryAttribute":"Why would you not give up your right to park at ASML, and what (if anything) would make you recon...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Why <\/strong>would you not give up your right to park at ASML, and <strong>what <\/strong>(if anything) would make you <strong>reconsider<\/strong>?<br \/>\n<br \/>\n<em>(This can include financial or non\u2011financial benefits.)<\/em>","DefaultChoices":false,"DataExportTag":"Q628","QuestionID":"QID628","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why would you not give up your right to park at ASML, and what (if anything) would make you recon...","InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID626\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Was there at least one situation in which you chose to give up your right to park at ASML in the previous hypothetical situations?<\/span> <span class=\"LeftOpDesc\">No<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID626\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID626","QuestionIDFromLocator":"QID626","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","MinChars":"1","ContentType":null,"ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"2000","Max":"","NumDecimals":""}}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID629","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q629","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID629"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID63","SecondaryAttribute":"Having given up your parking right in the above scenario, which transport mode would you choose t...","TertiaryAttribute":null,"Payload":{"QuestionText":"Having given up your parking right in the above scenario, which transport mode would you choose to commute to ASML?","DataExportTag":"Q63","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Having given up your parking right in the above scenario, which transport mode would you choose t...","Choices":{"1":{"Display":"P+R"},"2":{"Display":"Vanpool"},"3":{"Display":"Public Transport"},"4":{"Display":"(e-)Bicycle"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID63","InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID62\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Now imagine ASML makes the following voluntary offer.\n\nIf you accept this offer, you give up your right to park on the ASML campus for 4 years.\n\nYou will still be allowed to park at all Park and Ri...<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID62\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID62","QuestionIDFromLocator":"QID62","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true}}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID630","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br \/>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00 (NS business card)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/bike_allowance}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br \/>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br \/>\n\t\t\tdepartures<br \/>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br \/>\nFor the exact definitions of the transport modes and variables, you can click the tab below:\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q630","QuestionID":"QID630","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID633","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br>\nImportant note<\/h2>\n<br>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">\u20ac 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- \u20ac 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ \u20ac 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br>\n\t\t\tdepartures<br>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\"><br>\n\t\t\t&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br>\nFor the exact definitions of the transport modes and variables, you can click on the tab below:\n<br><br><h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. \u201cNone\u201d means no reservation is available. \u201cPriority system\u201d means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. \u201cStandard system\u201d means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q633","QuestionID":"QID633","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID634","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br>\nImportant note<\/h2>\n<br>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/bike_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- \u20ac 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ \u20ac 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br>\nFor the exact definitions of the transport modes and variables, you can click the tab below:\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. \u201cNone\u201d means no reservation is available. \u201cPriority system\u201d means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. \u201cStandard system\u201d means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n<\/ul>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q634","QuestionID":"QID634","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID635","SecondaryAttribute":"Instructions\u00a0 \u00a0 In the next part of the survey, you will choose between different hypothetical wa.","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nInstructions&nbsp;<\/h1>\n\n<h3>&nbsp;<\/h3>\n\n<p>\n<style type=\"text\/css\">a {\n    text-decoration: none;\n    color: #464feb;\n}\ntr th, tr td {\n    border: 1px solid #e6e6e6;\n}\ntr th {\n    background-color: #f5f5f5;\n}\n<\/style>\nIn the next part of the survey, you will choose between different hypothetical ways of commuting to campus. Each question shows several options that vary in travel time, costs, and conditions, and you should imagine that all options apply directly to you. For every choice, assume you are commuting on the busiest days of the week: Tuesday and Thursday. Compare the options in each table and select the one you would most often choose under typical busy weekday conditions.<\/p>\n\n<h3>&nbsp;<\/h3>\n\n<h2>Important note<\/h2>\n\n<h2>&nbsp;<\/h2>\nAll commute options in this survey are hypothetical. They may differ from current policies, facilities, or rewards that exist at ASML.<br \/>\n<br \/>\n<br \/>\nOn the next page, you will first see an example to show how the commute options are presented.","DefaultChoices":false,"DataExportTag":"Q635","QuestionID":"QID635","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions\u00a0 \u00a0 In the next part of the survey, you will choose between different hypothetical wa...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID636","SecondaryAttribute":"Instructions\u00a0 \u00a0 In the next part of the survey, you will choose between different hypothetical wa.","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nInstructions&nbsp;<\/h1>\n\n<h3>&nbsp;<\/h3>\n\n<p>\n<style type=\"text\/css\">a {\n    text-decoration: none;\n    color: #464feb;\n}\ntr th, tr td {\n    border: 1px solid #e6e6e6;\n}\ntr th {\n    background-color: #f5f5f5;\n}\n<\/style>\nIn the next part of the survey, you will choose between different hypothetical ways of commuting to campus. Each question shows several options that vary in travel time, costs, and conditions, and you should imagine that all options apply directly to you. For every choice, assume you are commuting on the busiest days of the week: Tuesday and Thursday. Compare the options in each table and select the one you would most often choose under typical busy weekday conditions.&nbsp;You will be presented with&nbsp;<strong>6 hypothetical situations<\/strong>.<\/p>\n\n<h3>&nbsp;<\/h3>\n\n<h2>Important note<\/h2>\n\n<h2>&nbsp;<\/h2>\nAll commute options in this survey are hypothetical. They may differ from current policies, facilities, or rewards that exist at ASML.<br \/>\n<br \/>\n<br \/>\nOn the next page, you will first see an example to show how the commute options are presented.","DefaultChoices":false,"DataExportTag":"Q636","QuestionID":"QID636","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions\u00a0 \u00a0 In the next part of the survey, you will choose between different hypothetical wa...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID637","SecondaryAttribute":"Instructions\u00a0 \u00a0 In the next part of the survey, you will choose between different hypothetical wa.","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nInstructions&nbsp;<\/h1>\n\n<h3>&nbsp;<\/h3>\n\n<p>\n<style type=\"text\/css\">a {\n    text-decoration: none;\n    color: #464feb;\n}\ntr th, tr td {\n    border: 1px solid #e6e6e6;\n}\ntr th {\n    background-color: #f5f5f5;\n}\n<\/style>\nIn the next part of the survey, you will choose between different hypothetical ways of commuting to campus. Each question shows several options that vary in travel time, costs, and conditions, and you should imagine that all options apply directly to you. For every choice, assume you are commuting on the busiest days of the week: Tuesday and Thursday. Compare the options in each table and select the one you would most often choose under typical busy weekday conditions.<\/p>\n\n<h3>&nbsp;<\/h3>\n\n<h2>Important note<\/h2>\n\n<h2>&nbsp;<\/h2>\nAll commute options in this survey are hypothetical. They may differ from current policies, facilities, or rewards that exist at ASML.<br \/>\n<br \/>\n<br \/>\nOn the next page, you will first see an example to show how the commute options are presented.","DefaultChoices":false,"DataExportTag":"Q637","QuestionID":"QID637","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions\u00a0 \u00a0 In the next part of the survey, you will choose between different hypothetical wa...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID638","SecondaryAttribute":"Are you familiar with ASML\u2019s vanpooling service?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you familiar with ASML\u2019s <b>vanpooling<\/b> service?","DataExportTag":"Q638","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are you familiar with ASML\u2019s vanpooling service?","Choices":{"1":{"Display":"Yes, I know about it"},"2":{"Display":"I have heard of it, but I don\u2019t know the details"},"4":{"Display":"No, I am not aware of it"}},"ChoiceOrder":["1","2","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID638","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID3\/ChoiceTextEntryValue","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">What is the approximate distance, in kilometers, between your home address and your primary ASML work location?\n\nNote:   Your ASML\u2011calculated distance can be found in MyCommute and is used to deter...<\/span> <span class=\"LeftOpDesc\">Text Response<\/span> <span class=\"OpDesc\">Is Greater Than<\/span> <span class=\"RightOpDesc\"> 20 <\/span>","LeftOperand":"q:\/\/QID3\/ChoiceTextEntryValue","LogicType":"Question","Operator":"GreaterThan","QuestionID":"QID3","QuestionIDFromLocator":"QID3","QuestionIsInLoop":"no","RightOperand":"20","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID12\/SelectableChoice\/4\/2","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">In a typical work week, how often do you commute using each of the following transport modes to t...<\/span> <span class=\"LeftOpDesc\">Vanpool - 1x a week<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID12\/SelectableChoice\/4\/2","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID12","QuestionIDFromLocator":"QID12","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID12\/SelectableChoice\/4\/3","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">In a typical work week, how often do you commute using each of the following transport modes to t...<\/span> <span class=\"LeftOpDesc\">Vanpool - 2x a week<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID12\/SelectableChoice\/4\/3","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID12","QuestionIDFromLocator":"QID12","QuestionIsInLoop":"no","Type":"Expression"},"3":{"ChoiceLocator":"q:\/\/QID12\/SelectableChoice\/4\/4","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">In a typical work week, how often do you commute using each of the following transport modes to t...<\/span> <span class=\"LeftOpDesc\">Vanpool - 3x a week<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID12\/SelectableChoice\/4\/4","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID12","QuestionIDFromLocator":"QID12","QuestionIsInLoop":"no","Type":"Expression"},"4":{"ChoiceLocator":"q:\/\/QID12\/SelectableChoice\/4\/5","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">In a typical work week, how often do you commute using each of the following transport modes to t...<\/span> <span class=\"LeftOpDesc\">Vanpool - 4x a week<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID12\/SelectableChoice\/4\/5","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID12","QuestionIDFromLocator":"QID12","QuestionIsInLoop":"no","Type":"Expression"},"5":{"ChoiceLocator":"q:\/\/QID12\/SelectableChoice\/4\/6","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">In a typical work week, how often do you commute using each of the following transport modes to t...<\/span> <span class=\"LeftOpDesc\">Vanpool - 5x a week<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID12\/SelectableChoice\/4\/6","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID12","QuestionIDFromLocator":"QID12","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID639","SecondaryAttribute":"What is vanpool? Vanpooling is a shared commuting option where a group of employees travels toget...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>What is vanpool?<\/h2>\n<br \/>\nVanpooling is a shared commuting option where a group of employees travels together to campus in a professionally driven shuttle. The vanpool is organized specifically for ASML employees and is designed to reduce individual car use and commuting costs.<br \/>\n<br \/>\nVanpooling is available in Uden, Veghel, Rosmalen, and &#39;s-Hertogenbosch.&nbsp;The shuttles depart from a location that is easily accessible for both the shuttle and employees, such as a carpool spot or a free parking area with bicycle parking facilities.<br \/>\n<br \/>\nThe <b>pick-up locations<\/b> in each city are as follows:\n\n<ul>\n\t<li><strong>Rosmalen<\/strong>:&nbsp;Carpoolplaats Rosmalen&nbsp;<\/li>\n\t<li><strong>&lsquo;s-Hertogenbosch East<\/strong>:&nbsp;Parkeerplaats Station &lsquo;s-Hertogenbosch Oost&nbsp;<\/li>\n\t<li><strong>&rsquo;s-Hertogenbosch Centre<\/strong>: Kiss and ride Station Den Bosch&nbsp;<\/li>\n\t<li><strong>Veghel<\/strong>:&nbsp;Carpool Veghel Noord&nbsp;<\/li>\n\t<li><strong>Uden<\/strong>: Foodcourt Uden-Noord&nbsp;<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q639","QuestionID":"QID639","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is vanpool? Vanpooling is a shared commuting option where a group of employees travels toget...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID638\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Are you familiar with ASML\u2019s vanpooling service?<\/span> <span class=\"LeftOpDesc\">I have heard of it, but I don\u2019t know the details<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID638\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID638","QuestionIDFromLocator":"QID638","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID638\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Are you familiar with ASML\u2019s vanpooling service?<\/span> <span class=\"LeftOpDesc\">No, I am not aware of it<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID638\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID638","QuestionIDFromLocator":"QID638","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true}}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID64","SecondaryAttribute":"Which vanpool location, if any, is\u00a0convenient(\u2139) for you?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which vanpool location, if any, is&nbsp;<span title=\"Here, 'convenient' means the location that is the easiest and most practical for you to reach in your daily routine. It is not necessarily the closest one geographically\u2014you might prefer a stop that fits better with your commuting route, allows an easier transfer (e.g., at Den Bosch station), or matches your travel habits.\">convenient<span style=\"font-size:11px;\"><i style=\"margin-left:3px; cursor:help;\">(\u2139)<\/i><\/span><\/span><span style=\"font-size:11px;\"> <\/span>for you?","DataExportTag":"Q64","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which vanpool location, if any, is\u00a0convenient(\u2139) for you?","Choices":{"1":{"Display":"Rosmalen"},"2":{"Display":"\u2018s-Hertogenbosch East"},"3":{"Display":"\u2019s-Hertogenbosch Centre"},"4":{"Display":"Veghel"},"5":{"Display":"Uden"},"6":{"Display":"None of the locations are convenient for me","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID12\/SelectableChoice\/4\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">\n\nIn a typical work week, how often do you commute using each of the following transport modes to travel between your home address and your primary ASML work location?\nNote: Your selections should ...<\/span> <span class=\"LeftOpDesc\">Vanpool - 0x a week<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID12\/SelectableChoice\/4\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID12","QuestionIDFromLocator":"QID12","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},"ChoiceOrder":[1,2,3,4,5,"6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID64","DynamicChoicesData":[],"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\