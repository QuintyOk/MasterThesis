uestionID":"QID1219841836"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219841837","SecondaryAttribute":"Now again imagine the same voluntary offer as before. You can give up your parking rights for 4 y...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now again imagine <strong>the same voluntary offer as before<\/strong>.\nYou can give up your parking rights for 4 years in exchange for one of four rewards\n<span title=\"Rewards: Free e\u2011bike (\u20ac2,000); Home EV charging station; Unlimited public transport; \u20ac2,000 cash (gross)\"\n      style=\"cursor: help; font-size:1.1em;\">\n  \ud83d\udec8\n<\/span>.\nYou would still be able to park at the P+R.","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now again imagine the same voluntary offer as before. You can give up your parking rights for 4 y...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1219841836\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Car<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219841836\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219841836","QuestionIDFromLocator":"QID1219841836","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID1219841836\/SelectableChoice\/2","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">P+R<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219841836\/SelectableChoice\/2","LogicType":"Question","Ope