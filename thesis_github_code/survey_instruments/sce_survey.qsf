n:center; background-color:#ffffff;\">- &euro; 3.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"Commuters living more than 20 km away can reserve starting 1 week before. Those living 20 km or closer can only reserve starting 24 hours before.\">Priority system <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">${e:\/\/Field\/ParkingGuaranteed}<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\