oop":"no","Type":"Expression"},"4":{"ChoiceLocator":"q:\/\/QID1219833382\/SelectableChoice\/5","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">(e)-Bicycle<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219833382\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219833382","QuestionIDFromLocator":"QID1219833382","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"Now imagine ASML introduces a <strong>voluntary program<\/strong> where you can <strong>choose to give up your right to park<\/strong> on the ASML campus <strong>for 3 years<\/strong> <em>(you would still be allowed to park at the P+R locations!).<\/em>&nbsp;In exchange, you can request <b>one <\/b>of the following rewards:<br><br>\n1. A free <b>e\u2011bike<\/b> worth \u20ac2,000\n<div style=\"margin-left: 40px;\"><\/div>\n2. A free home <b>EV charging station\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n3. <b>Unlimited <\/b>public transport (including private trips)<div style=\"margin-left: 40px;\"><\/div>\n4. \u20ac2,000 <b>cash <\/b>(gross<b>)\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n\n<div><br>\nBased on the<u> <b>same scenario in the table above<\/b><\/u>, would you be willing to give up your parking rights for 3 years (<em>not including right to park at P+R locations<\/em>)?<\/div>","DataExportTag":"Q32","QuestionID":"QID1219833383"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219833384","SecondaryAttribute":"Having given up your parking right in the above scenario, which transport mode would you choose t...","TertiaryAt