2,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"Based on the above scenario, which transport mode would you choose?","DataExportTag":"Q3","QuestionID":"QID1219841767"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219841768","SecondaryAttribute":"Now imagine ASML makes the following voluntary offer. If you accept this offer, you give up your...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now imagine ASML makes the following <strong>voluntary offer.<\/strong><br>\n<br>\nIf you accept this offer, you give up your <strong>right to park on the ASML campus for 4 years<\/strong>.<br>\n<br>\nYou will <strong>still be allowed to park at all Park and Ride (P+R) locations!<\/strong>\n<p>&nbsp;<\/p>\n\n<p>In return, you can choose <strong>one of the following&nbsp;<\/strong>rewards:<\/p>\n\n<ol>\n\t<li>A free <b>e\u2011bike<\/b> worth \u20ac2,000<\/li>\n\t<li>A free home <b>EV charging station<\/b><\/li>\n\t<li><b>Unlimited <\/b>public transport (including private trips)<\/li>\n\t<li>\u20ac2,000 <b>cash <\/b>(gross<b>)<\/b><\/li>\n<\/ol>\n\n<div><br>\nBased on the <b>same scenario shown in the table above,<\/b> would you accept this offer?<\/div>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now imagine ASML makes the following voluntary offer. If you accept this offer, you give up your...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1219841767\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Car<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219841767\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219841767","QuestionIDFromLocator":"QID1219841767","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID1219841767\/SelectableChoice\/2","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">P+R<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219841767\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219841767","QuestionIDFromLocator":"QID1219841767","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID1219841767\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"Error\">Invalid Logic<\/span> <a href=\"javascript:void(0)\" clickcallback=\"Qualtrics.DisplayLogic.edit:DL_66089573\" instanceid=\"LE_69238190\">Click Here to Edit Logic<\/a>","LeftOperand":"q:\/\/QID1219841767\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219841767","QuestionIDFromLocator":"QID1219841767","QuestionIsInLoop":"no","Type":"Expression"},"3":{"ChoiceLocator":"q:\/\/QID1219841767\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">(e)-Bicycle<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219841767\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219841767","QuestionIDFromLocator":"QID1219841767","QuestionIsInLoop":"no","Type":"Expression"},"4":{"ChoiceLocator":"q:\/\/QID1219841767\/SelectableChoice\/5","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Public Transport<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219841767\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219841767","QuestionIDFromLocator":"QID1219841767","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"Now imagine ASML introduces a <strong>voluntary program<\/strong> where you can <strong>choose to give up your right to park<\/strong> on the ASML campus <strong>for 3 years<\/strong> <em>(you would still be allowed to park at the P+R locations!).<\/em>&nbsp;In exchange, you can request <b>one <\/b>of the following rewards:<br><br>\n1. A free <b>e\u2011bike<\/b> worth \u20ac2,000\n<div style=\"margin-left: 40px;\"><\/div>\n2. A free home <b>EV charging station\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n3. <b>Unlimited <\/b>public transport (including private trips)<div style=\"margin-left: 40px;\"><\/div>\n4. \u20ac2,000 <b>cash <\/b>(gross<b>)\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n\n<div><br>\nBased on the<u> <b>same scenario in the table above<\/b><\/u>, would you be willing to give up your parking rights for 3 years (<em>not including right to park at P+R locations<\/em>)?<\/div>","DataExportTag":"Q4","QuestionID":"QID1219841768"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219841769","SecondaryAttribute":"Having given up your parking right in the above scenario, which transport mode would you choose t...","TertiaryAttribute":null,"Payload":{"QuestionText":"Having given up your parking right in the above scenario, which transport mode would you choose to commute to ASML?","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private