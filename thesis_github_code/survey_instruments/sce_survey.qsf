onType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Testing: ${e:\/\/Field\/new_time} ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID44","SecondaryAttribute":"Survey on Access and Mobility at ASML Dear colleague, We would like your opinion on a subject imp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Survey on Access and Mobility at ASML<\/h2>\n<br>\nDear colleague,<br>\n<br>\nWe would like your opinion on a subject important to you - your (daily) commute to campus.<br>\n<br>\nAnswering all questions takes 15 - 20 minutes in total.<br>\n<br>\n\n\n<p>Your participation is voluntary, and all responses will be treated confidentially and analysed in aggregated form only. \n\nThis survey is fully anonymous. No names, contact details, or identifying information are collected, and responses cannot be traced back to you.<\/p>\n\n<p><br><\/p><p>Thank you for taking the time to share your perspective. You can click below to start the survey.<br>\n&nbsp;<\/p>\nRegards,<br>\nTeam Access &amp; Mobility","DefaultChoices":false,"DataExportTag":"Intro","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Survey on Access and Mobility at ASML Dear colleague, We would like your opinion on a subject imp...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID44","QuestionJS":false}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"Vanpool The next questions are about vanpool. Vanpooling is a shared commuting option where a gro...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Vanpool<\/h2>\n<br \/>\nThe next questions are about vanpool.<br \/>\n<br \/>\nVanpooling is a shared commuting option where a group of employees travels together to campus in a professionally driven shuttle. The vanpool is organized specifically for ASML employees and is designed to reduce individual car use and commuting costs.<br \/>\n<br \/>\nVanpooling is available in Uden, Veghel, Rosmalen, and &#39;s-Hertogenbosch.&nbsp;The shuttles depart from a location that is easily accessible for both the shuttle and employees, such as a carpool spot or a free parking area with bicycle parking facilities.<br \/>\n<br \/>\nThe <b>pick-up locations<\/b> in each city are as follows:\n\n<ul>\n\t<li><strong>Rosmalen<\/strong>:&nbsp;Carpoolplaats Rosmalen&nbsp;<\/li>\n\t<li><strong>&lsquo;s-Hertogenbosch East<\/strong>:&nbsp;Parkeerplaats Station &lsquo;s-Hertogenbosch Oost&nbsp;<\/li>\n\t<li><strong>&rsquo;s-Hertogenbosch Centre<\/strong>: Kiss and ride Station Den Bosch&nbsp;<\/li>\n\t<li><strong>Veghel<\/strong>:&nbsp;Carpool Veghel Noord&nbsp;<\/li>\n\t<li><strong>Uden<\/strong>: Foodcourt Uden-Noord&nbsp;<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"vanpool","QuestionID":"QID45","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Vanpool The next questions are about vanpool. Vanpooling is a shared commuting option where a gro...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"In a typical week, how many days do you commute to the office?","TertiaryAttribute":null,"Payload":{"QuestionText":"In a typical week, how <b>many days<\/b> do you <b>commute to the office<\/b>?","DataExportTag":"Q46","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"In a typical week, how many days do you commute to the office?","Choices":{"1":{"Display":"0 days per week"},"2":{"Display":"1 day per week"},"3":{"Display":"2 days per week"},"4":{"Display":"3 days per week"},"5":{"Display":"4 days per week"},"6":{"Display":"5 days per week"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID46"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Commuting Time","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Commuting Time<\/h2>","DefaultChoices":false,"DataExportTag":"Q47","QuestionID":"QID47","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Commuting Time","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"Based on the above scenario, which transport mode would you choose?","TertiaryAttribute":null,"Payload":{"QuestionText":"Based on the above scenario, which transport mode would you choose?","DataExportTag":"Q48","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Based on the above scenario, which transport mode would you choose?","Choices":{"1":{"Display":"Car"},"2":{"Display":"P+R"},"3":{"Display":"Vanpool"},"4":{"Display":"Public Transport"},"5":{"Display":"(e)-Bicycle"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":