;\">\n  \ud83d\udec8\n<\/span>.\nYou would still be able to park at the P+R.","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now again imagine the same voluntary offer as before. You can give up your parking rights for 4 y...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1219833378\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Car<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219833378\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219833378","QuestionIDFromLocator":"QID1219833378","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID1219833378\/SelectableChoice\/2","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">P+R<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219833378\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219833378","QuestionIDFromLocator":"QID1219833378","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID1219833378\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Vanpool<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219833378\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219833378","QuestionIDFromLocator":"QID1219833378","QuestionIsInLoop":"no","Type":"Expression"},"3":{"ChoiceLocator":"q:\/\/QID1219833378\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Public Transport<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219833378\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219833378","QuestionIDFromLocator":"QID1219833378","QuestionIsInLoop":"no","Type":"Expression"},"4":{"ChoiceLocator":"q:\/\/QID1219833378\/SelectableChoice\/5","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">(e)-Bicycle<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219833378\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219833378","QuestionIDFromLocator":"QID1219833378","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"Now imagine ASML introduces a <strong>voluntary program<\/strong> where you can <strong>choose to give up your right to park<\/strong> on the ASML campus <strong>for 3 years<\/strong> <em>(you would still be allowed to park at the P+R locations!).<\/em>&nbsp;In exchange, you can request <b>one <\/b>of the following rewards:<br><br>\n1. A free <b>e\u2011bike<\/b> worth \u20ac2,000\n<div style=\"margin-left: 40px;\"><\/div>\n2. A free home <b>EV charging station\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n3. <b>Unlimited <\/b>public transport (including private trips)<div style=\"margin-left: 40px;\"><\/div>\