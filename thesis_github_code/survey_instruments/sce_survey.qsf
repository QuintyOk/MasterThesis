\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br>\n\t\t\tdepartures<br>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2x per hour<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>","DataExportTag":"Q30","QuestionID":"QID1219843866"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219843867","SecondaryAttribute":"Based on the above scenario, which transport mode would you choose?","TertiaryAttribute":null,"Payload":{"QuestionText":"Based on the above scenario, which transport mode would you choose?","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Based on the above scenario, which transport mode would you choose?","Choices":{"1":{"Display":"Car"},"2":{"Display":"P+R"},"3":{"Display":"Vanpool"},"4":{"Display":"Public Transport"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"Based on the above scenario, which transport mode would you choose?","DataExportTag":"Q31","QuestionID":"QID1219843867"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219843868","SecondaryAttribute":"Now again imagine the same voluntary offer as before. You can give up your parking rights for 4 y...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now again imagine <strong>the same voluntary offer as before<\/strong>.\nYou can give up your parking rights for 4 years in exchange for one of four rewards\n<span title=\"Rewards: Free e\u2011bike (\u20ac2,000); Home EV charging station; Unlimited public transport; \u20ac2,000 cash (gross)\"\n      style=\"cursor: help; font-size:1.1em;\">\n  \ud83d\udec8\n<\/span>.\nYou would still be able to park at the P+R.","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now again imagine the same voluntary offer as before. You can give up your parking rights for 4 y...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1219843867\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Car<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219843867\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219843867","QuestionIDFromLocator":"QID1219843867","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID1219843867\/SelectableChoice\/2","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">P+R<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219843867\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219843867","QuestionIDFromLocator":"QID1219843867","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID1219843867\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Vanpool<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219843867\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219843867","QuestionIDFromLocator":"QID1219843867","QuestionIsInLoop":"no","Type":"Expression"},"3":{"ChoiceLocator":"q:\/\/QID1219843867\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Public Transport<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219843867\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219843867","QuestionIDFromLocator":"QID1219843867","QuestionIsInLoop":"no","Type":"Expression"},"4":{"ChoiceLocator":"q:\/\/QID1219843867\/SelectableChoice\/5","Conjuction":"Or","Description":"<span class=\"Error\">Invalid Logic<\/span> <a href=\"javascript:void(0)\" clickcallback=\"Qualtrics.DisplayLogic.edit:DL_59623356\" instanceid=\"LE_85364542\">Click Here to Edit Logic<\/a>","LeftOperand":"q:\/\/QID1219843867\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219843867","QuestionIDFromLocator":"QID1219843867","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"Now imagine ASML introduces a <strong>voluntary program<\/strong> where you can <strong>choose to give up your right to park<\/strong> on the ASML campus <strong>for 3 years<\/strong> <em>(you would still be allowed to park at the P+R locations!).<\/em>&nbsp;In exchange, you can request <b>one <\/b>of the following rewards:<br><br>\n1. A free <b>e\u2011bike<\/b> worth \u20ac2,000\n<div style=\"margin-left: 40px;\"><\/div>\n2. A free home <b>EV charging station\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n3. <b>Unlimited <\/b>public transport (including private trips)<div style=\"margin-left: 40px;\"><\/div>\n4. \u20ac2,000 <b>cash <\/b>(gross<b>)\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n\n<div><br>\nBased on the<u> <b>same scenario in the table above<\/b><\/u>, would you be willing to give up your parking rights for 3 years (<em>not including right to park at P+R locations<\/em>)?<\/div>","DataExportTag":"Q32","QuestionID":"QID1219843868"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219843869","SecondaryAttribute":"Having given up your parking right in the above scenario, which transport mode would you choose t...","TertiaryAttribute":null,"Payload":{"QuestionText":"Having given up your parking right in the above scenario, which transport mode would you choose to commute to ASML?","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Having given up your parking right in the above scenario, which transport mode would you choose t...","Choices":{"1":{"Display":"P+R"},"2":{"Display":"Vanpool"},"3":{"Display":"Public Transport"}},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1219843868\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Now imagine ASML makes the following voluntary offer.\n\nIf you accept this offer, you give up your right to park on the ASML campus for 3 years.\n\nYou will still be allowed to park at all Park and Ri...<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1219843868\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1219843868","QuestionIDFromLocator":"QID1219843868","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Having given up your parking right in the above scenario, which transport mode would you choose to commute to ASML?","DataExportTag":"Q33","QuestionID":"QID1219843869"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219870320","SecondaryAttribute":"Instructions\u00a0 \u00a0 We will now move on to the next part of the survey. In this section, you will be..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nInstructions&nbsp;<\/h1>\n\n<h3>&nbsp;<\/h3>\n\n<p>We will now move on to the next part of the survey. In this section, you will be asked to make choices about different ways of commuting to campus.<\/p>\n\n<h2><br \/>\nWhat this section is about<\/h2>\n\n<h2>&nbsp;<\/h2>\n\n<p>You will choose between different commute options. Each question presents several travel options that differ in travel time, costs, and conditions.<br \/>\n&nbsp;<\/p>\n\n<p>All commute options shown are hypothetical. Please imagine that they apply directly to you and that all options shown are available to you. These options may differ from current policies, facilities, or rewards at ASML.<\/p>\n\n<h3>&nbsp;<\/h3>\n\n<h2>Starting point for all choices<\/h2>\n\n<h2>&nbsp;<\/h2>\nIn every scenario, assume that you must travel to campus on the busiest days of the week. These days are Tuesday and Thursday.\n\n<h3>&nbsp;<\/h3>\n\n<h2>How to make your choice<\/h2>\n\n<h2>&nbsp;<\/h2>\n\n<p>You will see tables that compare multiple commute options side by side. Each option has advantages and disadvantages. Some options may be faster but cost more, while others may take longer but cost less. There is no right or wrong answer.<\/p>\n\n<p><br \/>\nYour task is to compare the options within each table and select the commute option you would most often choose under typical busy weekday conditions.&nbsp;<\/p>\n\n<h3>&nbsp;<\/h3>\n\n<h2>Important note<\/h2>\n\n<h2>&nbsp;<\/h2>\nAll commute options in this survey are hypothetical. They may differ from current policies, facilities, or rewards that exist at ASML.<br \/>\n<br \/>\n<br \/>\nOn the next page, you will first see an example to show how the commute options are presented.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions\u00a0 \u00a0 We will now move on to the next part of the survey. In this section, you will be...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionText_Unsafe":"<h1><br \/>\nInstructions&nbsp;<\/h1>\n\n<h3>&nbsp;<\/h3>\n\n<p>We will now move on to the next part of the survey. In this section, you will be asked to make choices about different ways of commuting to campus.<\/p>\n\n<h2><br \/>\nWhat this section is about<\/h2>\n\n<h2>&nbsp;<\/h2>\n\n<p>You will choose between different commute options. Each question presents several travel options that differ in travel time, costs, and conditions.<br \/>\n&nbsp;<\/p>\n\n<p>All commute options shown are hypothetical. Please imagine that they apply directly to you and that all options shown are available to you. These options may differ from current policies, facilities, or rewards at ASML.<\/p>\n\n<h3>&nbsp;<\/h3>\n\n<h2>Starting point for all choices<\/h2>\n\n<h2>&nbsp;<\/h2>\nIn every scenario, assume that you must travel to campus on the busiest days of the week. These days are Tuesday and Thursday.\n\n<h3>&nbsp;<\/h3>\n\n<h2>How to make your choice<\/h2>\n\n<h2>&nbsp;<\/h2>\n\n<p>You will see tables that compare multiple commute options side by side. Each option has advantages and disadvantages. Some options may be faster but cost more, while others may take longer but cost less. There is no right or wrong answer.<\/p>\n\n<p><br \/>\nYour task is to compare the options within each table and select the commute option you would most often choose under typical busy weekday conditions.&nbsp;<\/p>\n\n<h3>&nbsp;<\/h3>\n\n<h2>Important note<\/h2>\n\n<h2>&nbsp;<\/h2>\nAll commute options in this survey are hypothetical. They may differ from current policies, facilities, or rewards that exist at ASML.<br \/>\n<br \/>\n<br \/>\nOn the next page, you will first see an example to show how the commute options are presented.","DataExportTag":"Q1","QuestionID":"QID1219870320"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID1219870321","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nThis page is only an example. You do not need to make a choice here.<br \/>\n&nbsp;<\/p>\n\n<h2>How to read the table<\/h2>\n<br \/>\n&nbsp;The table compares several commute options side by side.\n<ul>\n\t<li>Each <strong>column<\/strong> represents a different way of commuting to campus.<\/li>\n\t<li>Each <strong>row<\/strong> shows a feature of those commute options, such as travel time, parking, or rewards.<\/li>\n\t<li>The values shown are illustrative and are based on information you provided earlier.<\/li>\n<\/ul>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your total travel time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Total travel<br \/>\n\t\t\tallowance<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br \/>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br \/>\n\t\t\tdepartures<br \/>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;\n\n<h2><a href=\"\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h2>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated total travel time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Total travel allowance:<\/strong> The commuting reimbursement you receive for traveling by car. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","QuestionText_Unsafe":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nThis page is only an example. You do not need to make a choice here.<br \/>\n&nbsp;<\/p>\n\n<h2>How to read the table<\/h2>\n<br \/>\n&nbsp;The table compares several commute options side by side.\n<ul>\n\t<li>Each <strong>column<\/strong> represents a different way of commuting to campus.<\/li>\n\t<li>Each <strong>row<\/strong> shows a feature of those commute options, such as travel time, parking, or rewards.<\/li>\n\t<li>The values shown are illustrative and are based on information you provided earlier.<\/li>\n<\/ul>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your total travel time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Total travel<br \/>\n\t\t\tallowance<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00 (NS business card)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/bike_allowance}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br \/>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br \/>\n\t\t\tdepartures<br \/>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;\n\n<h2><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h2>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated total travel time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Total travel allowance:<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","DataExportTag":"Q2","QuestionID":"QID1219870321"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"What is the approximate distance, in kilometers, between your home address and your primary ASML...","TertiaryAttribute":null,"Payload":{"QuestionText":"What is the approximate distance, in kilometers, between your home address and your primary ASML work location?","DefaultChoices":false,"DataExportTag":"Q13","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the approximate distance, in kilometers, between your home address and your primary ASML...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"0","Max":"","NumDecimals":""},"AITextAnalysis":{"Checks":[{"Type":"Partial","Messages":"default"},{"Type":"OverlyGeneralized","Messages":"default"},{"Type":"NonInsightful","Messages":"default"},{"Type":"InsufficientDetail","Messages":"default"},{"Type":"Gibberish","Messages":"default"}]}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID13"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q14","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID14"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"On a typical work day, how many minutes does it take you to travel by car from your home address...","TertiaryAttribute":null,"Payload":{"QuestionText":"On a typical work day, how many <b>minutes <\/b>does it take you to travel by <b>car <\/b>from your home address to your ASML work location, <i>including your usual traffic<\/i>?&nbsp;<br \/>\n<br \/>\nIf you are not sure, an estimation is fine.<br \/>\n<style type=\"text\/css\">a {\n    text-decoration: none;\n    color: #464feb;\n}\ntr th, tr td {\n    border: 1px solid #e6e6e6;\n}\ntr th {\n    background-color: #f5f5f5;\n}\n<\/style>\n\ud83d\ude97","DefaultChoices":false,"DataExportTag":"Q15","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"On a typical work day, how many minutes does it take you to travel by car from your home address...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"0","Max":"","NumDecimals":""},"AITextAnalysis":{"Checks":[{"Messages":"default","Type":"Partial"},{"Messages":"default","Type":"OverlyGeneralized"},{"Messages":"default","Type":"NonInsightful"},{"Messages":"default","Type":"InsufficientDetail"},{"Messages":"default","Type":"Gibberish"}]}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID15","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID18\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Do you have a car available for your commute to ASML, regardless of your actual use of car?<\/span> <span class=\"LeftOpDesc\">No, (almost) never<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID18\/SelectableChoice\/4","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID18","QuestionIDFromLocator":"QID18","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID12\/SelectableChoice\/1\/1","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">In a typical work week, how often do you commute using each of the following transport modes to t...<\/span> <span class=\"LeftOpDesc\">Car \/ motorbike + park at ASML campus - 0x a week<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID12\/SelectableChoice\/1\/1","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID12","QuestionIDFromLocator":"QID12","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID12\/SelectableChoice\/2\/1","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">In a typical work week, how often do you commute using each of the following transport modes to t...<\/span> <span class=\"LeftOpDesc\">Car \/ motorbike + park at P+R - 0x a week<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID12\/SelectableChoice\/2\/1","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID12","QuestionIDFromLocator":"QID12","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n\n  const q = this.questionContainer;\n  const input = q.querySelector('input[type=\"text\"]');\n  if (!input) return;\n\n  \/* ----- outer wrapper (vertical layout) ----- *\/\n  const outer = document.createElement('div');\n  outer.style.display = 'flex';\n  outer.style.flexDirection = 'column';\n  outer.style.alignItems = 'flex-start';\n\n  input.parentNode.insertBefore(outer, input);\n\n  \/* ----- row for input + unit ----- *\/\n  const row = document.createElement('div');\n  row.style.display = 'inline-flex';\n  row.style.alignItems = 'center';\n  row.style.gap = '8px';\n\n  outer.appendChild(row);\n  row.appendChild(input);\n\n  const unit = document.createElement('span');\n  unit.textContent = 'minutes'; \/\/ change if needed\n  unit.style.fontSize = '14px';\n\n  row.appendChild(unit);\n\n  \/* ----- note BELOW the answer box ----- *\/\n  const note = document.createElement('div');\n  note.textContent = 'Enter a single number (for example: 15).';\n  note.style.fontSize = '12px';\n  note.style.color = '#555';\n  note.style.marginTop = '6px';\n\n  outer.appendChild(note);\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"On a typical work day, how many minutes does it take you to travel by (e\u2011)bike from your home add.","TertiaryAttribute":null,"Payload":{"QuestionText":"On a typical work day, how many <b>minutes <\/b>does it take you to travel by <b>(e\u2011)bike<\/b> from your home address to your ASML work location?&nbsp;<br \/>\n<br \/>\nIf you are not sure, an estimation is fine.<br \/>\n\ud83d\udeb2","DefaultChoices":false,"DataExportTag":"Q16","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"On a typical work day, how many minutes does it take you to travel by (e\u2011)bike from your home add...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"0","Max":"","NumDecimals":""},"AITextAnalysis":{"Checks":[{"Messages":"default","Type":"Partial"},{"Messages":"default","Type":"OverlyGeneralized"},{"Messages":"default","Type":"NonInsightful"},{"Messages":"default","Type":"InsufficientDetail"},{"Messages":"default","Type":"Gibberish"}]}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID16","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID3\/ChoiceTextEntryValue","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">What is the approximate distance, in kilometers, between your home address and your primary ASML work location?\n\nNote:   Your ASML\u2011calculated distance can be found in MyCommute and is used to deter...<\/span> <span class=\"LeftOpDesc\">Text Response<\/span> <span class=\"OpDesc\">Is Less Than<\/span> <span class=\"RightOpDesc\"> 30 <\/span>","LeftOperand":"q:\/\/QID3\/ChoiceTextEntryValue","LogicType":"Question","Operator":"LessThan","QuestionID":"QID3","QuestionIDFromLocator":"QID3","QuestionIsInLoop":"no","RightOperand":"30","Type":"Exp