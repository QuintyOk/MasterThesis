ptionOption":"UseText"},"QuestionDescription":"Based on the above scenario, which transport mode would you choose?","Choices":{"1":{"Display":"Vanpool"},"2":{"Display":"(e-)Bicycle"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID52"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"Based on the above scenario, which transport mode would you choose?","TertiaryAttribute":null,"Payload":{"QuestionText":"Based on the above scenario, which transport mode would you choose?","DataExportTag":"Q53","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Based on the above scenario, which transport mode would you choose?","Choices":{"1":{"Display":"Vanpool"},"2":{"Display":"(e-)Bicycle"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID53"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"Imagine ASML introduces a voluntary program where you can choose to give up your right to park on...","TertiaryAttribute":null,"Payload":{"QuestionText":"Imagine ASML introduces a <strong>voluntary program<\/strong> where you can <strong>choose to give up your right to park<\/strong> on the ASML campus <strong>for 3 years<\/strong> <em>(you would still be allowed to park at the P+R locations!)<\/em> in exchange for one of the following rewards:<br><br>\n<b>1. A free e\u2011bike worth \u20ac2,000\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n<b>2. A free home EV charging station\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n<b>3. Unlimited public transport\n\n<\/b><div style=\"margin-left: 40px;\"><\/div>\n<strong>4. \u20ac2,000 cash (gross)<\/strong>\n\n<div style=\"margin-left: 40px;\"><\/div>\n\n<div><br>\nBased on the<u> same scenario in the table above<\/u>, would you be willing to give up your parking rights for 3 years (<em>not including right to park at P+R locations<\/em>)?<\/div>","DataExportTag":"Q54","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Imagine ASML introduces a voluntary program where you can choose to give up your right to park on...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID54","InPageDisplayLogic":{"0":{"0":{"QuestionID":"QID48","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID48\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID48","LeftOperand":"q:\/\/QID48\/SelectableChoice\/1","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">Car<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"1":{"QuestionID":"QID48","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID48\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID48","LeftOperand":"q:\/\/QID48\/SelectableChoice\/2","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Based on the above scenario, which transport mode would you choose?<\/span> <span class=\"LeftOpDesc\">P+R<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","Conjuction":"Or"},"2":{"QuestionID":"QID48","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID48\/SelectableChoice\/3","Operator":"Selected","QuestionIDFromLocator":"QID48","LeftOperand":"q:\/\/QID48\/SelectableChoice\/3","Type":"Expression","