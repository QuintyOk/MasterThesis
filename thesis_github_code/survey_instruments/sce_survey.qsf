ttings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"QuestionID":"QID640","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID640\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID640","LeftOperand":"q:\/\/QID640\/SelectableChoice\/1","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">If there were a vanpool location near you, how likely would you be to use it for your commute?<\/span> <span class=\"LeftOpDesc\">Very likely<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"1":{"QuestionID":"QID640","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID640\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID640","LeftOperand":"q:\/\/QID640\/SelectableChoice\/2","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">If there were a vanpool location near you, how likely would you be to use it for your commute?<\/span> <span class=\"LeftOpDesc\">Likely<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","Conjuction":"Or"},"2":{"QuestionID":"QID640","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID640\/SelectableChoice\/3","Operator":"Selected","QuestionIDFromLocator":"QID640","LeftOperand":"q:\/\/QID640\/SelectableChoice\/3","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">If there were a vanpool location near you, how likely would you be to use it for your commute?<\/span> <span class=\"LeftOpDesc\">Neither likely nor unlikely<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","Conjuction":"Or"},"Type":"If"},"Type":"BooleanExpression","inPage":true}}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID642","SecondaryAttribute":"Thank you for sharing your thoughts with us by completing the survey. Your feedback truly makes a...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Thank you for sharing your thoughts with us by completing the survey. Your feedback truly makes a difference and helps guide our next steps. We appreciate your involvement and commitment to improving mobility together.<\/p>\n\n<h2>Keep moving with us.&nbsp;<\/h2>","DefaultChoices":false,"DataExportTag":"Q642","QuestionID":"QID642","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for sharing your thoughts with us by completing the survey. Your feedback truly makes a...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID643","SecondaryAttribute":"Last question of this survey Is there anything else you would like to share with us?","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Last question of this survey<\/h2>\n<br \/>\nIs there anything else you would like to share with us?","DefaultChoices":false,"DataExportTag":"Q643","QuestionID":"QID643","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Last question of this survey Is there anything else you would like to share with us?","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID644","SecondaryAttribute":"Keep moving with us.\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Keep moving with us.&nbsp;<\/h3>","DefaultChoices":false,"DataExportTag":"Q644","QuestionID":"QID644","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Keep moving with us.\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID645","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q645","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID645"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID646","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br \/>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00 (NS business card)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/bike_allowance}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br \/>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br \/>\n\t\t\tdepartures<br \/>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br \/>\nFor the exact definitions of the transport modes and variables, you can click the tab below:\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q646","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID646"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID647","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br \/>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<br \/>\nFor the exact definitions of the transport modes and variables, you can click the tab below:<br \/>\n&nbsp;\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q647","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID647"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID648","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br \/>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<br \/>\nFor the exact definitions of the transport modes and variables, you can click the tab below:<br \/>\n&nbsp;\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q648","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID648"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID649","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br>\nImportant note<\/h2>\n<br>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/bike_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- \u20ac 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ \u20ac 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br>\nFor the exact definitions of the transport modes and variables, you can click the tab below:\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. \u201cNone\u201d means no reservation is available. \u201cPriority system\u201d means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. \u201cStandard system\u201d means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q649","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID649"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID65","SecondaryAttribute":"Is your selected\u00a0vanpool location a feasible (\u2139) option for you?","TertiaryAttribute":null,"Payload":{"QuestionText":"Is your selected&nbsp;vanpool location a <span title=\"Here, 'feasible' means the location is realistically workable for your commute. It should be easy enough to reach without causing a major detour, delay, or inconvenience.\"> feasible <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span> option for you?","DataExportTag":"Q65","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Is your selected\u00a0vanpool location a feasible (\u2139) option for you?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID65","InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">Rosmalen<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/2","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">\u2018s-Hertogenbosch East<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">\u2019s-Hertogenbosch Centre<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"3":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">Veghel<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"4":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/5","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">Uden<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true}}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID650","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br \/>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/bike_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br \/>\nFor the exact definitions of the transport modes and variables, you can click the tab below:\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q650","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID650"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID651","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br>\nImportant note<\/h2>\n<br>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">\u20ac 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- \u20ac 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ \u20ac 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br>\n\t\t\tdepartures<br>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\"><br>\n\t\t\t&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br>\nFor the exact definitions of the transport modes and variables, you can click on the tab below:\n<br><br><h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. \u201cNone\u201d means no reservation is available. \u201cPriority system\u201d means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. \u201cStandard system\u201d means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q651","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID651"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID652","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br>\nImportant note<\/h2>\n<br>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">\u20ac 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00 (NS business card)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- \u20ac 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">\u20ac 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ \u20ac 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br>\n\t\t\tdepartures<br>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\"><br>\n\t\t\t&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br>\nFor the exact definitions of the transport modes and variables, you can click on the tab below:\n<br><br><h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. \u201cNone\u201d means no reservation is available. \u201cPriority system\u201d means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. \u201cStandard system\u201d means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q652","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID652"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID653","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br \/>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00 (NS business card)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/bike_allowance}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br \/>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br \/>\n\t\t\tdepartures<br \/>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br \/>\nFor the exact definitions of the transport modes and variables, you can click the tab below:\n<h3><a href=\"\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q653","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID653"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID654","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your Commuter allowance time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Commuter allowance<br \/>\n\t\t\t(one way)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00 (NS business card)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/bike_allowance}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br \/>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br \/>\n\t\t\tdepartures<br \/>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br \/>\nFor the exact definitions of the transport modes and variables, you can click the tab below:\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Commuter allowance (one way):<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q654","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID654"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID655","SecondaryAttribute":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1><br \/>\nExample commute choice<\/h1>\n&nbsp;\n\n<p>Below is an example of the type of table you will see in the next part of the survey. It shows how different commute options are compared.<\/p>\n\n<p><br \/>\nYou do not need to make a choice here yet.<\/p>\n\n<h2><br \/>\nImportant note<\/h2>\n<br \/>\nPlease keep in mind that<strong><em> the table does not include every possible cost or benefit associated with each travel option<\/em><\/strong>. For example, fuel costs are not shown. When choosing options like the vanpool, you may save money on fuel or other personal travel expenses, even though these are not displayed in the table.<br \/>\n&nbsp;\n<table style=\"width:100%; max-width:700px; border-collapse:collapse; font-family:Arial, sans-serif; margin-top:10px; white-space:nowrap;\">\n\t<thead>\n\t\t<tr style=\"background-color:#e8e8e8; border-bottom:2px solid #ccc;\">\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f0f0f0;\">&nbsp;<\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Car<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>P+R<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><b>Vanpool<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><b>Public Transport<\/b><\/th>\n\t\t\t<th style=\"padding:10px; text-align:center; background-color:#ffffff;\"><strong>(e)-Bicycle<\/strong><\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr style=\"border-top:1px solid #ddd;\">\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Time<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID15\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${e:\/\/Field\/PR_time} min <span title=\"This time represents your total travel time from your home address to your ASML work location. It includes your trip from home to the P+R location and from the P+R location to work.\"> <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${e:\/\/Field\/vp_time} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">${q:\/\/QID17\/ChoiceTextEntryValue} min<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">${q:\/\/QID16\/ChoiceTextEntryValue} min<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Total travel<br \/>\n\t\t\tallowance<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ ${e:\/\/Field\/car_allowance}<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00 (NS business card)<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">+ ${e:\/\/Field\/bike_allowance}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tcost<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">- &euro; 1.50<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">&euro; 0.00<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\treservation<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\"><span title=\"No reservation system in place.\">None <i style=\"margin-left:3px; cursor:help; font-size:11px;\">(\u2139)<\/i> <\/span><\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Parking<br \/>\n\t\t\tguaranteed<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#ffffff;\">No<\/td>\n\t\t\t<td style=\"text-align:center; background-color:#f7f7f7;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">P+R<br \/>\n\t\t\treward<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#f7f7f7;\">+ &euro; 1.50<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Emergency<br \/>\n\t\t\ttaxi guaranteed<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">Yes<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:10px; font-weight:bold; text-align:center; background-color:#f0f0f0;\">Vanpool<br \/>\n\t\t\tdepartures<br \/>\n\t\t\tper hour<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"padding:10px; text-align:center; background-color:#ffffff;\">2<\/td>\n\t\t\t<td style=\"background-color:#f7f7f7;\">&nbsp;<\/td>\n\t\t\t<td style=\"background-color:#ffffff;\">&nbsp;<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n&nbsp;<br \/>\nFor the exact definitions of the transport modes and variables, you can click the tab below:\n<h3><a href=\"javascript:void(0)\" id=\"moreInfoToggle\" style=\"font-weight:600;\">Click here for more information \u25bc <\/a><\/h3>\n\n<div id=\"moreInfoContent\" style=\"display:none; margin-top:12px;\">\n<p><strong>Transport modes in the table<\/strong><\/p>\n\n<p>The transport mode shown in the table refers to the main part of your commute, meaning the mode you use for the longest or most important part of the trip to campus.<\/p>\n\n<ul>\n\t<li><strong>Car:<\/strong> Traveling mainly by private car for the commute.<\/li>\n\t<li><strong>P+R:<\/strong> Driving to a Park and Ride location outside campus and continuing to campus by shuttle service or electric bicycle. In this survey, Park and Ride refers specifically to P+R Koningshof.<\/li>\n\t<li><strong>Vanpool:<\/strong> Traveling mainly by a shared, professionally driven van that is exclusively available to ASML employees.<\/li>\n\t<li><strong>Public transport:<\/strong> Traveling mainly by scheduled public transport, such as bus or train. This includes any walking or cycling needed to reach or leave stops or stations.<\/li>\n\t<li><strong>(e)-Bicycle:<\/strong> Traveling mainly by bicycle or electric bicycle for the commute.<\/li>\n<\/ul>\n\n<p><strong>Fixed characteristics<\/strong><\/p>\n\n<p>These characteristics are based on the information you provided earlier in the survey. They stay the same within a table and across questions.<\/p>\n\n<ul>\n\t<li><strong>Time:<\/strong> The estimated total travel time from your home to campus for each commute option. This estimate is based on your earlier answers.<\/li>\n\t<li><strong>Total travel allowance:<\/strong> The commuting reimbursement you receive for traveling by car or bicycle. This amount is calculated using the distance you provided earlier.<\/li>\n<\/ul>\n\n<p><strong>Variable characteristics<\/strong><\/p>\n\n<p>These characteristics differ between commute options and may also change from one question to another. They describe differences in costs, conditions, or additional benefits.<\/p>\n\n<ul>\n\t<li><strong>Parking cost:<\/strong> The amount you pay for parking per day when choosing this option. If the value is negative, this means you pay that amount per day.<\/li>\n\t<li><strong>Parking reservation:<\/strong> Indicates whether and how you can reserve a parking space in advance. &ldquo;None&rdquo; means no reservation is available. &ldquo;Priority system&rdquo; means commuters living more than 20 km away can reserve one week in advance, while those living 20 km or closer can reserve 24 hours in advance. &ldquo;Standard system&rdquo; means everyone can reserve one week in advance.<\/li>\n\t<li><strong>Parking guaranteed:<\/strong> Indicates whether a parking space is guaranteed when you arrive. If parking is not guaranteed, availability may vary and you may need to search for parking.<\/li>\n\t<li><strong>P+R reward:<\/strong> The financial reward you receive for choosing the Park and Ride option.<\/li>\n\t<li><strong>Emergency taxi guaranteed:<\/strong> Indicates whether an emergency taxi is provided and paid for if you need to leave immediately and the vanpool departure times do not align with your situation.<\/li>\n\t<li><strong>Vanpool departures per hour:<\/strong> Shows how many vanpool trips depart each hour. A higher number means shorter waiting times and more flexibility.<\/li>\n<\/ul>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\n  var toggle = document.getElementById(\"moreInfoToggle\");\n  var content = document.getElementById(\"moreInfoContent\");\n\n  if (toggle && content) {\n    toggle.onclick = function() {\n      if (content.style.display === \"none\") {\n        content.style.display = \"block\";\n        toggle.innerHTML = \"More information \u25b2\";\n      } else {\n        content.style.display = \"none\";\n        toggle.innerHTML = \"More information \u25bc\";\n      }\n    };\n  }\n\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q655","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Example commute choice \u00a0 Below is an example of the type of table you will see in the next part o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID655"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID656","SecondaryAttribute":"Your Current Commute This section asks how long your commute takes, as well as how long other com...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Your Current Commute<\/h2>\n<br \/>\nThis section asks how long your commute takes, as well as how long <strong>other<\/strong> commute options would take for you. This is why<span style=\"color:#2980b9;\"><strong> you may also be asked about transport modes you do not usually use<\/strong><\/span>.<span style=\"color:#2980b9;\"><strong>&nbsp;<\/strong><\/span>\n<style type=\"text\/css\">a {\n    text-decoration: none;\n    color: #464feb;\n}\ntr th, tr td {\n    border: 1px solid #e6e6e6;\n}\ntr th {\n    background-color: #f5f5f5;\n}\n<\/style>\nThis helps us better understand your available options, commuting habits, and how mobility support could be improved.","DefaultChoices":false,"DataExportTag":"Q656","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Your Current Commute This section asks how long your commute takes, as well as how long other com...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID656"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID66","SecondaryAttribute":"How many minutes does it take you to travel from your home to the ...","TertiaryAttribute":null,"Payload":{"QuestionText":"How many <b>minutes <\/b>does it take you to travel from your home to the <i>${q:\/\/QID64\/ChoiceGroup\/SelectedChoices} <\/i><b>vanpool pickup location<\/b> using your preferred mode of transport?&nbsp;If you are not sure, an estimation is fine.<br \/>\n<br \/>\n<span style=\"font-size:13px;\">The <b>pick-up locations<\/b> in each city were as follows:<\/span>\n<ul>\n\t<li><span style=\"font-size:13px;\"><strong>Rosmalen<\/strong>:&nbsp;Carpoolplaats Rosmalen&nbsp;<\/span><\/li>\n\t<li><span style=\"font-size:13px;\"><strong>&lsquo;s-Hertogenbosch East<\/strong>:&nbsp;Parkeerplaats Station &lsquo;s-Hertogenbosch Oost&nbsp;<\/span><\/li>\n\t<li><span style=\"font-size:13px;\"><strong>&rsquo;s-Hertogenbosch Centre<\/strong>: Kiss and ride Station Den Bosch&nbsp;<\/span><\/li>\n\t<li><span style=\"font-size:13px;\"><strong>Veghel<\/strong>:&nbsp;Carpool Veghel Noord&nbsp;<\/span><\/li>\n\t<li><span style=\"font-size:13px;\"><strong>Uden<\/strong>: Foodcourt Uden-Noord&nbsp;<\/span><\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q66","QuestionID":"QID66","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How many minutes does it take you to travel from your home to the ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","TotalChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"1","Max":"","NumDecimals":""}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">Rosmalen<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/2","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">\u2018s-Hertogenbosch East<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">\u2019s-Hertogenbosch Centre<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"3":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">Veghel<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"4":{"ChoiceLocator":"q:\/\/QID64\/SelectableChoice\/5","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Which vanpool location, if any, is&amp;nbsp;convenient(\u2139) for you?<\/span> <span class=\"LeftOpDesc\">Uden<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID64\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID64","QuestionIDFromLocator":"QID64","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n\n  const q = this.questionContainer;\n  const input = q.querySelector('input[type=\"text\"]');\n  if (!input) return;\n\n  \/* ----- outer wrapper (vertical layout) ----- *\/\n  const outer = document.createElement('div');\n  outer.style.display = 'flex';\n  outer.style.flexDirection = 'column';\n  outer.style.alignItems = 'flex-start';\n\n  input.parentNode.insertBefore(outer, input);\n\n  \/* ----- row for input + unit ----- *\/\n  const row = document.createElement('div');\n  row.style.display = 'inline-flex';\n  row.style.alignItems = 'center';\n  row.style.gap = '8px';\n\n  outer.appendChild(row);\n  row.appendChild(input);\n\n  const unit = document.createElement('span');\n  unit.textContent = 'minutes'; \/\/ change if needed\n  unit.style.fontSize = '14px';\n\n  row.appendChild(unit);\n\n  \/* ----- note BELOW the answer box ----- *\/\n  const note = document.createElement('div');\n  note.textContent = 'Enter a single number (for example: 15).';\n  note.style.fontSize = '12px';\n  note.style.color = '#555';\n  note.style.marginTop = '6px';\n\n  outer.appendChild(note);\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_3mhzO8uLuQDB9no","Element":"SQ","PrimaryAttribute":"QID67","SecondaryAttribute":"You will be presented with 8\u00a0hypothetical situations\/tables. Your responses help us gain better i..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>You will be presented with<b style=\"font-size: 13px;\"> <\/b><b>8&nbsp;hypothetical situations\/tables.<\/b> Your responses help us gain better insight into which factors are most important to you during your commute, as well as the trade-offs you make between different transport options.&nbsp;Changes from the previous table are highlighted <span style=\"color:#2980b9;\">in blue<\/span> for easy comparison.<\/p>\n<br \/>\n<span style=\"font-size:13px;\"><em>Note:&nbsp;<\/em><\/span> <span style=\"font-size:13px;\"> <em>The number shown at the start of each question does <strong>not<\/strong> indicate the order of the questions or how many questions you will see. It simply refers to the randomly assigned scenario you are presented with.<\/em><\/span>","DefaultChoices":false,"DataExportTag":"Q67","QuestionID":"QID67","QuestionType":"DB","Selec